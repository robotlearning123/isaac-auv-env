#usda 1.0
(
    upAxis = "Z"
)

def "World"
{
    def PhysicsScene "PhysicsScene"
    {
    }

    def Xform "BlueROV2Heavy" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.26, 0.23, 0.37)
        float physics:mass = 13.5
        custom string oceanscale:assetRole = "mvp_visual_proxy"
        custom bool oceanscale:cadDerived = false
        custom string oceanscale:dynamicsReference = "von Benzon et al. 2022 Table A1"
        custom string oceanscale:geometryReference = "scratch OpenUSD from public dimensions and von Benzon Table A1"
        custom int oceanscale:thrusterCount = 8
        custom string oceanscale:upgradeCandidate = "clydemcqueen/bluerov2_gz models/bluerov2_heavy, MIT in package.xml, DAE conversion not yet stable"
        custom string oceanscale:vehicle = "BlueROV2 Heavy"

        def Scope "Materials"
        {
            def Material "RobotHull"
            {
                token outputs:surface.connect = </World/BlueROV2Heavy/Materials/RobotHull/PreviewSurface.outputs:surface>

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.70, 0.76, 0.74)
                    float inputs:roughness = 0.56
                    float inputs:metallic = 0.05
                    token outputs:surface
                }
            }

            def Material "FrameBlack"
            {
                token outputs:surface.connect = </World/BlueROV2Heavy/Materials/FrameBlack/PreviewSurface.outputs:surface>

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.015, 0.025, 0.028)
                    float inputs:roughness = 0.50
                    float inputs:metallic = 0.20
                    token outputs:surface
                }
            }

            def Material "AcrylicPlate"
            {
                token outputs:surface.connect = </World/BlueROV2Heavy/Materials/AcrylicPlate/PreviewSurface.outputs:surface>

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.22, 0.72, 0.76)
                    color3f inputs:emissiveColor = (0.02, 0.10, 0.10)
                    float inputs:opacity = 0.34
                    float inputs:roughness = 0.18
                    token outputs:surface
                }
            }

            def Material "CameraGlass"
            {
                token outputs:surface.connect = </World/BlueROV2Heavy/Materials/CameraGlass/PreviewSurface.outputs:surface>

