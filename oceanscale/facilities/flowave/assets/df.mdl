mdl 1.8;
// df.mdl — Minimal stub for the MDL df (distribution function) standard library module.
//
// WARNING: The real df module is a compiler intrinsic shipped with the MDL SDK.
// This file exists as a local placeholder only. If your MDL toolchain provides
// the standard library (Isaac Sim, iray, MDL SDK), you should NOT use this file
// — remove it and let import df::* resolve to the built-in module instead.
//
// Symbols provided (sufficient for water_body.mdl):
//   - enum scatter_mode  (scatter_reflect, scatter_transmit, scatter_reflect_and_transmit)
//   - specular_bsdf()    (BSDF for specular reflection/transmission)
//   - anisotropic_vdf()  (VDF for Henyey-Greenstein phase function)
//
// Reference: MDL 1.8 spec §6.14 (anisotropic_vdf), §7.9 (specular_bsdf).

export enum scatter_mode {
    scatter_reflect = 0,
    scatter_transmit = 1,
    scatter_reflect_and_transmit = 2
};

// Specular BSDF — handles reflection and/or transmission at a smooth surface.
// Parameters:
//   mode — which scattering directions to evaluate
//   ior  — index of refraction as a color (per-channel)
export bsdf specular_bsdf(
    uniform scatter_mode mode = scatter_reflect,
    color ior = color(1.5)
);

// Anisotropic VDF — Henyey-Greenstein phase function for volume scattering.
// Parameters:
//   anisotropy — g ∈ (-1, 1); 0 = isotropic, >0 = forward, <0 = backward
export vdf anisotropic_vdf(
    float anisotropy = 0.0
);
