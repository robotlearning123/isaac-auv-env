        rel material:binding = </Building/Looks/SteelMat>
        point3f[] points = [(-25.25, -25.25, 0), (-24.75, -25.25, 0), (-24.75, -24.75, 0), (-25.25, -24.75, 0), (-25.25, -25.25, 12), (-24.75, -25.25, 12), (-24.75, -24.75, 12), (-25.25, -24.75, 12), (24.75, -25.25, 0), (25.25, -25.25, 0), (25.25, -24.75, 0), (24.75, -24.75, 0), (24.75, -25.25, 12), (25.25, -25.25, 12), (25.25, -24.75, 12), (24.75, -24.75, 12), (24.75, 24.75, 0), (25.25, 24.75, 0), (25.25, 25.25, 0), (24.75, 25.25, 0), (24.75, 24.75, 12), (25.25, 24.75, 12), (25.25, 25.25, 12), (24.75, 25.25, 12), (-25.25, 24.75, 0), (-24.75, 24.75, 0), (-24.75, 25.25, 0), (-25.25, 25.25, 0), (-25.25, 24.75, 12), (-24.75, 24.75, 12), (-24.75, 25.25, 12), (-25.25, 25.25, 12), (-25, -25.25, 10), (25, -25.25, 10), (25, -24.75, 10), (-25, -24.75, 10), (-25, -25.25, 11), (25, -25.25, 11), (25, -24.75, 11), (-25, -24.75, 11), (-25, 24.75, 10), (25, 24.75, 10), (25, 25.25, 10), (-25, 25.25, 10), (-25, 24.75, 11), (25, 24.75, 11), (25, 25.25, 11), (-25, 25.25, 11), (-25.25, -25, 10), (-24.75, -25, 10), (-24.75, 25, 10), (-25.25, 25, 10), (-25.25, -25, 11), (-24.75, -25, 11), (-24.75, 25, 11), (-25.25, 25, 11), (24.75, -25, 10), (25.25, -25, 10), (25.25, 25, 10), (24.75, 25, 10), (24.75, -25, 11), (25.25, -25, 11), (25.25, 25, 11), (24.75, 25, 11)]
