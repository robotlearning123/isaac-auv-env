    def Mesh "Ceiling" (
        assetInfo = {
            asset identifier = @flowave_hall_ceiling@
            string version = "0.1.0-flowave-placeholder"
        }
        kind = "component"
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
