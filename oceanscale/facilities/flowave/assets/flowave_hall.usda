#usda 1.0
(
    defaultPrim = "Building"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Building" (
    assetInfo = {
        asset identifier = @flowave_hall@
        string version = "0.1.0-flowave-placeholder"
    }
    kind = "component"
)
{
    def "Looks"
    {
        def Material "DarkConcreteMat"
        {
            token outputs:mdl:surface.connect = </Building/Looks/DarkConcreteMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.45, 0.45, 0.45)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.9
                token outputs:out
            }
        }

        def Material "SteelMat"
        {
            token outputs:mdl:surface.connect = </Building/Looks/SteelMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.6, 0.6, 0.6)
                float inputs:metallic_constant = 1
                float inputs:reflection_roughness_constant = 0.4
                token outputs:out
            }
        }

        def Material "LightGreyMat"
        {
            token outputs:mdl:surface.connect = </Building/Looks/LightGreyMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.85, 0.85, 0.85)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.7
                token outputs:out
            }
        }
    }

    def Mesh "Floor" (
        assetInfo = {
            asset identifier = @flowave_hall_floor@
            string version = "0.1.0-flowave-placeholder"
        }
        kind = "component"
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        rel material:binding = </Building/Looks/DarkConcreteMat>
        point3f[] points = [(-30, -30, -0.1), (30, -30, -0.1), (30, 30, -0.1), (-30, 30, -0.1), (-30, -30, 0), (30, -30, 0), (30, 30, 0), (-30, 30, 0)]
        uniform token subdivisionScheme = "none"
    }

