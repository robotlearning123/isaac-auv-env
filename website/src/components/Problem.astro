---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const content = isZh ? {
  label: 'Challenge',
  title: '海试很难，又慢又贵。',
  titleLines: ['海试很难，', '又慢又贵。'],
  body: '每一次下海都要等天气窗口、船期、人员、海况、布放装备和硬件状态同时满足。一次失败，往往意味着重新出船、重新布放，再等下一轮有效数据。',
  stats: [
    ['天气窗口', '窗口很窄'],
    ['船和人员', '按天计费'],
    ['迭代时间', '一次失败拖数周'],
  ],
} : {
  label: 'Challenge',
  title: 'Sea trials are hard, slow, and expensive.',
  titleLines: ['Sea trials are hard,', 'slow, and expensive.'],
  body: 'Field tests are gated by weather, boats, crew, currents, gear, and hardware risk. A failed run can mean rebooking, redeploying, and waiting weeks for the next useful dataset.',
  stats: [
    ['Weather', 'narrow windows'],
    ['Vessels + crew', 'day-rate cost'],
    ['Iteration time', 'weeks lost'],
  ],
};
---
<section id="vision" class="cinematic-section cinematic-section--left">
  <video
    class="cinematic-section__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-challenge-storm-seatrial-poster.jpg"
  >
    <source src="/videos/oceanscale-challenge-storm-seatrial.mp4" type="video/mp4" />
  </video>
  <div class="cinematic-section__shade"></div>

  <div class="cinematic-section__inner reveal">
    <div class="cinematic-section__copy">
      <p class="section-label">{content.label}</p>
      <h2>
        {'titleLines' in content
          ? content.titleLines.map((line) => <span>{line}</span>)
          : content.title}
      </h2>
      <p class="section-body">{content.body}</p>
      <div class="section-stats" aria-label={isZh ? '挑战指标' : 'Challenge metrics'}>
        {content.stats.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .cinematic-section {
    position: relative;
    min-height: 92vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .cinematic-section__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .cinematic-section__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.92) 0%, rgba(3, 7, 12, 0.62) 42%, rgba(3, 7, 12, 0.12) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .cinematic-section--right .cinematic-section__shade {
    background:
      linear-gradient(270deg, rgba(3, 7, 12, 0.92) 0%, rgba(3, 7, 12, 0.6) 42%, rgba(3, 7, 12, 0.1) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .cinematic-section__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 1280px);
    margin-inline: auto;
    padding: 7rem 0;
    max-width: 1280px;
  }

  .cinematic-section--right .cinematic-section__inner {
    display: grid;
  }

  .cinematic-section__copy {
    width: min(100%, 720px);
  }

  .cinematic-section--right .cinematic-section__copy {
    justify-self: end;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 1.15rem;
    color: rgba(45, 212, 191, 0.95);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-label::before {
    content: "";
    width: 2.1rem;
    height: 1px;
    background: rgba(45, 212, 191, 0.75);
  }

  .cinematic-section h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.6vw, 4.55rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.55);
  }

  html[lang="zh"] .cinematic-section h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
    word-break: normal;
    overflow-wrap: normal;
  }

  .cinematic-section h2 span {
    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }

  .section-body {
    margin: 1.45rem 0 0;
    max-width: 590px;
    color: rgba(232, 237, 243, 0.82);
    font-size: 1.02rem;
    line-height: 1.68;
  }

  .section-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    width: min(100%, 600px);
    margin-top: 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.12);
  }

  .section-stats div {
    min-height: 5.55rem;
    padding: 0.9rem 1rem;
    background: rgba(3, 7, 12, 0.68);
    backdrop-filter: blur(12px);
  }

  .section-stats span,
  .section-stats strong {
    display: block;
    font-family: var(--font-mono);
    line-height: 1.3;
  }

  .section-stats span {
    color: rgba(232, 237, 243, 0.52);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-stats strong {
    margin-top: 0.62rem;
    color: #fff;
    font-size: 0.88rem;
    letter-spacing: 0;
  }

  @media (max-width: 760px) {
    .cinematic-section {
      min-height: auto;
      display: block;
      padding-top: 56.25vw;
    }

    .cinematic-section__media {
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: contain;
      object-position: top center;
    }

    .cinematic-section__shade,
    .cinematic-section--right .cinematic-section__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0) 0%, rgba(3, 7, 12, 0.34) 34%, var(--color-bg) 68%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .cinematic-section__inner {
      width: min(100% - 2rem, 1280px);
      padding: 2rem 0 4rem;
    }

    .cinematic-section--right .cinematic-section__inner {
      display: block;
    }

    .cinematic-section__copy,
    .cinematic-section--right .cinematic-section__copy {
      width: 100%;
    }

    .cinematic-section h2 {
      max-width: 100%;
      font-size: 2.28rem;
      line-height: 1.08;
      text-wrap: auto;
    }

    .cinematic-section h2 span {
      width: auto;
      white-space: normal;
    }

    html:not([lang="zh"]) .cinematic-section h2 {
      font-size: 2.06rem;
      line-height: 1.06;
    }

    html[lang="zh"] .cinematic-section h2 {
      max-width: 100%;
    }

    .section-label {
      margin-bottom: 0.85rem;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
    }

    .section-label::before {
      width: 1.55rem;
    }

    .section-body {
      margin-top: 1.1rem;
      font-size: 0.97rem;
      line-height: 1.56;
    }

    .section-stats {
      grid-template-columns: 1fr;
      width: 100%;
      margin-top: 1.75rem;
    }

    .section-stats div {
      min-height: 0;
      padding: 0.82rem 1rem;
    }

    .section-stats strong {
      margin-top: 0.42rem;
      font-size: 0.86rem;
    }
  }

  @media (min-width: 1440px) {
    .cinematic-section h2 {
      font-size: 4.7rem;
    }

    .section-body {
      font-size: 1.06rem;
    }
  }

  @media (max-width: 1120px) and (min-width: 761px) {
    .cinematic-section h2 {
      font-size: 3.4rem;
    }
  }
</style>
