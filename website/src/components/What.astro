---
import zhData from '../content/zh/what';
import enData from '../content/en/what';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, capabilities } = fm;
---
<section id="what" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10">
    <img src="/images/what-bg.jpg" alt="" class="w-full h-full object-cover opacity-20" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-0)]/80 via-[var(--color-abyss-1)]/85 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3">/03 · {eyebrow}</div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-16 tracking-tight max-w-4xl">{title}</h2>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border-deep)] border border-[var(--color-border-deep)]">
    {capabilities.map((c: { metric?: string | null; metricLabel: string; title: string; body: string }) => (
      <div class="bg-[var(--color-abyss-1)] p-8 hover:bg-[var(--color-abyss-2)] transition-colors group min-h-[14rem] flex flex-col">
        {c.metric ? (
          <div class="font-mono text-4xl md:text-5xl text-[var(--color-lumen)] font-bold leading-none mb-1">
            {c.metric}
          </div>
        ) : (
          <div class="w-10 h-10 mb-2 flex items-center justify-center border border-[var(--color-border-deep)] group-hover:border-[var(--color-lumen)] transition-colors">
            <div class="w-1.5 h-1.5 bg-[var(--color-lumen)] rounded-full"></div>
          </div>
        )}
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-paper-dim)] mb-5 mt-1">
          {c.metricLabel}
        </div>
        <h3 class="font-display text-lg md:text-xl font-semibold text-[var(--color-paper)] mb-2 leading-tight">{c.title}</h3>
        <p class="text-[var(--color-paper-dim)] text-sm leading-relaxed">{c.body}</p>
      </div>
    ))}
  </div>
  </div>
</section>
