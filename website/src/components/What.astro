---
import zhData from '../content/zh/what';
import enData from '../content/en/what';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const fm = lang === 'zh' ? zhData : enData;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
type Cap = { metricLabel: string; title: string; body: string };
---
<section id="what" class="os-section os-section--surface os-focus-section">
  <div class="os-container os-split os-split--reverse">
    <div>
      <div class="os-kicker">/02 · {fm.eyebrow}</div>
      <h2 class="os-h2 os-section-title">{strip(fm.title)}</h2>
      <p class="os-body">
        {lang === 'zh'
          ? '面向 AUV 与 ROV 的 GPU-native 训练平台。'
          : 'A GPU-native training platform for AUVs and ROVs.'}
      </p>
    </div>

    <div class="os-architecture" aria-label={strip(fm.title)}>
      <div class="os-architecture__node os-architecture__node--core">Newton + Warp</div>
      <div class="os-architecture__node">Fossen 6-DOF</div>
      <div class="os-architecture__node">Sensors</div>
      <div class="os-architecture__node">Gymnasium</div>
      <div class="os-architecture__node">Policy</div>
    </div>

    <div class="os-card-row os-card-row--four">
      {(fm.capabilities as Cap[]).map((c) => (
        <div class="os-card">
          <span class="os-card__index">{c.metricLabel}</span>
          <h3>{strip(c.title)}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
