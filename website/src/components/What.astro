---
import zhData from '../content/zh/what';
import enData from '../content/en/what';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
const lead =
  lang === 'zh'
    ? '一个面向 AUV 与 ROV 的 GPU-native 训练平台：物理、水动力、传感器与策略接口在同一循环中运行。'
    : 'A GPU-native training platform for AUVs and ROVs: physics, hydrodynamics, sensors, and policy interfaces in one loop.';
---
<section id="what" class="landing-section section-dark">
  <div class="section-inner">
    <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
      <div class="section-header mb-0">
        <p class="section-kicker">/02 · {fm.eyebrow}</p>
        <h2 class="section-title">{cleanHeadline(fm.title)}</h2>
        <p class="section-copy">{lead}</p>
      </div>
      <figure class="media-frame">
        <img
          src="/images/platform-desk.webp"
          alt={lang === 'zh' ? 'OceanScale 开发者工作台' : 'OceanScale developer workspace'}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <figcaption>{lang === 'zh' ? '开发者工作台 · 仿真、训练、基准' : 'Developer workspace · simulation, training, benchmarks'}</figcaption>
      </figure>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {fm.capabilities.map((capability: { metricLabel: string; title: string; body: string }) => (
        <article class="landing-card capability-card">
          <div class="card-index">{capability.metricLabel}</div>
          <h3>{cleanHeadline(capability.title)}</h3>
          <p>{capability.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
