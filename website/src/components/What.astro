---
import zhData from '../content/zh/what';
import enData from '../content/en/what';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm = lang === 'zh' ? zhData : enData;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
type Cap = { metricLabel: string; title: string; body: string };
---
<section id="what" class="os-section os-section--dark">
  <div class="os-container">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <div class="os-kicker">/02 · {fm.eyebrow}</div>
        <h2 class="os-h2">{strip(fm.title)}</h2>
        <p class="os-body">
          {lang === 'zh'
            ? '一个面向 AUV 与 ROV 的 GPU-native 训练平台：物理、水动力、传感器与策略接口在同一循环中运行。'
            : 'A GPU-native training platform for AUVs and ROVs: physics, hydrodynamics, sensors, and policy interfaces in one loop.'}
        </p>
      </div>
      <figure class="os-frame">
        <img
          src="/images/platform-desk.webp"
          alt={lang === 'zh' ? 'OceanScale 开发者工作台' : 'OceanScale developer workspace'}
          class="aspect-[16/10] object-cover"
          loading="lazy"
        />
        <figcaption>{lang === 'zh' ? '仿真 · 训练 · 基准' : 'Simulation · training · benchmarks'}</figcaption>
      </figure>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-6">
      {(fm.capabilities as Cap[]).map((c, i) => (
        <div class={`os-card-delay-${i + 1}`}>
          <span class="os-card__index">{c.metricLabel}</span>
          <h3>{strip(c.title)}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
