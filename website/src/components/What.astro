---
import zhData from '../content/zh/what';
import enData from '../content/en/what';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, capabilities } = fm;
type Cap = { metric?: string | null; metricLabel: string; title: string; body: string };
const caps = capabilities as Cap[];
---
<section id="what" class="relative overflow-hidden py-24 md:py-32 min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/what-bg.jpg" alt="" class="w-full h-full object-cover opacity-20" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-0)]/80 via-[var(--color-abyss-1)]/85 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 w-full">
    <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3">/02 · {eyebrow}</div>
    <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-16 tracking-tight max-w-4xl leading-[1.05]">{title}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[var(--color-border-deep)] border border-[var(--color-border-deep)]">
      {caps.map((c) => (
          <div class="card-glow bg-[var(--color-abyss-1)] hover:bg-[var(--color-abyss-2)] group flex flex-col p-8 md:p-10 min-h-[18rem]">
            <div class="w-10 h-10 mb-3 flex items-center justify-center border border-[var(--color-border-deep)] group-hover:border-[var(--color-lumen)] transition-colors">
              <div class="w-1.5 h-1.5 bg-[var(--color-lumen)] rounded-full"></div>
            </div>
            <div class="font-mono uppercase tracking-[0.2em] text-[var(--color-paper-dim)] mb-5 mt-1 text-[10px]">
              {c.metricLabel}
            </div>
            <h3 class="font-display font-semibold text-[var(--color-paper)] mb-3 leading-tight text-xl md:text-2xl">{c.title}</h3>
            <p class="text-[var(--color-paper-dim)] leading-relaxed text-sm max-w-md">{c.body}</p>
          </div>
      ))}
    </div>
  </div>
</section>
