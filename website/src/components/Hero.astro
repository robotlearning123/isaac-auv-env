---
import zhData from '../content/zh/hero';
import enData from '../content/en/hero';
import zhStats from '../content/zh/stats';
import enStats from '../content/en/stats';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hero = lang === 'zh' ? zhData : enData;
const stats = lang === 'zh' ? zhStats : enStats;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
---
<section class="os-section os-section--dark relative">
  <div class="absolute inset-0 opacity-35" style="background: url('/images/hero-bg.webp') center/cover no-repeat;"></div>
  <div class="absolute inset-0" style="background: linear-gradient(160deg, var(--color-bg) 35%, transparent 100%);"></div>

  <div class="os-container relative grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center" style="padding-block: 1rem;">
    <div>
      <div class="os-kicker">{hero.eyebrow}</div>

      <h1 class="os-h1" style="max-width: 14ch;">
        {strip(hero.h1)}
      </h1>

      <p class="os-body italic" style="max-width: 48ch;">
        {hero.enemyLine}
      </p>

      <p style="margin-top: 0.75rem; color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
        {hero.sub}
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href="#benchmarks" class="os-btn os-btn--primary">
          {t('cta.demos')} <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="#contact" class="os-btn os-btn--ghost">{t('cta.contact')}</a>
      </div>

      <div class="grid grid-cols-3 gap-3 mt-10">
        {stats.items.map((s: any) => (
          <div class="os-metric">
            <div class="os-metric__value">{s.value}<span>{s.suffix}</span></div>
            <div class="os-metric__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <figure class="os-frame">
        <video autoplay loop muted playsinline poster="/images/hero-impact.webp" class="aspect-[16/10] object-cover">
          <source src="/videos/hero-storm.mp4" type="video/mp4" />
          <img src="/images/hero-impact.webp" alt="BlueROV2 on storm deck — DAY 4 WAITING" />
        </video>
        <figcaption>RTX 5090 · CUDA 12.9</figcaption>
      </figure>

      <div class="os-terminal">
        <div class="os-terminal__bar">
          <span class="os-terminal__dot os-terminal__dot--red"></span>
          <span class="os-terminal__dot os-terminal__dot--yellow"></span>
          <span class="os-terminal__dot os-terminal__dot--green"></span>
          <span class="os-terminal__title">oceanscale run</span>
        </div>
        <pre><code><span class="prompt">$</span> pip install oceanscale
<span class="muted">collecting oceanscale</span>
<span class="prompt">$</span> oceanscale demo bluerov2-hover --envs 64
<span class="muted">sim</span> <span class="bold">17,427 env-steps/s</span>
<span class="muted">model</span> Fossen 6-DoF · Newton+Warp
<span class="muted">status</span> <span class="bold">reproducible benchmark ready</span></code></pre>
      </div>
    </div>
  </div>
</section>
