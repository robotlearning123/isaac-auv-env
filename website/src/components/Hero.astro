---
import zhData from '../content/zh/hero';
import enData from '../content/en/hero';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fm: any = lang === 'zh' ? zhData : enData;
const { h1, sub, eyebrow } = fm;
---
<section class="relative overflow-hidden pt-36 pb-32 md:pt-52 md:pb-44 min-h-[88vh] flex items-center">
  {/* Cinematic background image (SpaceX-style) */}
  <div class="absolute inset-0 -z-10">
    <img src="/images/hero-bg.jpg" alt="" class="w-full h-full object-cover opacity-55" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-0)]/40 via-[var(--color-abyss-0)]/65 to-[var(--color-abyss-1)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[var(--color-abyss-1)] to-transparent"></div>
  </div>

  {/* Sonar ping rings, decorative */}
  <div class="absolute top-1/2 right-[-8rem] md:right-[-4rem] opacity-30 pointer-events-none -z-0">
    <div class="sonar-ping"></div>
    <div class="sonar-ping"></div>
    <div class="sonar-ping"></div>
  </div>

  <div class="relative max-w-[1280px] mx-auto px-6 grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-8 relative z-10">
      <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-7 anim-rise">
        {eyebrow}
      </div>
      <h1 class="font-display text-balance text-5xl md:text-7xl lg:text-[5.5rem] font-bold leading-[1.04] text-[var(--color-paper)] mb-8 tracking-tight anim-rise delay-150">
        {h1}
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-paper)]/85 max-w-2xl mb-10 leading-relaxed anim-rise delay-300">
        {sub}
      </p>
      <div class="flex flex-wrap items-center gap-4 anim-rise delay-500">
        <a href="#demos" class="btn-lumen">
          {t('cta.demos')}
          <span aria-hidden="true">→</span>
        </a>
        <a href="#contact" class="btn-ghost">{t('cta.contact')}</a>
      </div>
    </div>

    {/* Sonar dial SVG */}
    <div class="lg:col-span-4 hidden lg:block relative aspect-square anim-rise delay-700">
      <svg viewBox="0 0 200 200" class="w-full h-full">
        <defs>
          <radialGradient id="sweepGradient">
            <stop offset="0%" stop-color="#4DEEEA" stop-opacity="0.5"/>
            <stop offset="100%" stop-color="#4DEEEA" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle cx="100" cy="100" r="98" fill="none" stroke="#1F3047" stroke-width="0.5"/>
        <circle cx="100" cy="100" r="75" fill="none" stroke="#1F3047" stroke-width="0.5"/>
        <circle cx="100" cy="100" r="50" fill="none" stroke="#1F3047" stroke-width="0.5"/>
        <circle cx="100" cy="100" r="25" fill="none" stroke="#1F3047" stroke-width="0.5"/>
        <line x1="100" y1="2" x2="100" y2="198" stroke="#1F3047" stroke-width="0.3"/>
        <line x1="2" y1="100" x2="198" y2="100" stroke="#1F3047" stroke-width="0.3"/>
        <g>
          <path d="M 100 100 L 100 2 A 98 98 0 0 1 198 100 Z" fill="url(#sweepGradient)" opacity="0.4">
            <animateTransform attributeName="transform" type="rotate" from="0 100 100" to="360 100 100" dur="10s" repeatCount="indefinite"/>
          </path>
        </g>
        <circle cx="100" cy="100" r="3" fill="#4DEEEA"/>
        <circle cx="100" cy="100" r="2" fill="#02050C"/>
        <text x="100" y="195" text-anchor="middle" fill="#4DEEEA" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.7" letter-spacing="2">{t('hero.sonarLabel')}</text>
      </svg>
    </div>
  </div>
</section>
