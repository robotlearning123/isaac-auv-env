---
import zhData from '../content/zh/hero';
import enData from '../content/en/hero';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fm: any = lang === 'zh' ? zhData : enData;
const { h1, sub, eyebrow } = fm;
const metrics = lang === 'zh'
  ? [
      { label: 'Single-env', value: '11,435 FPS', detail: 'BlueROV2 · RTX 5090' },
      { label: 'Vectorized', value: '90M', detail: 'env-steps/s · 8192 envs' },
      { label: 'Physics', value: '6-DoF', detail: 'Fossen kernel' },
    ]
  : [
      { label: 'Single-env', value: '11,435 FPS', detail: 'BlueROV2 · RTX 5090' },
      { label: 'Vectorized', value: '90M', detail: 'env-steps/s · 8192 envs' },
      { label: 'Physics', value: '6-DoF', detail: 'Fossen kernel' },
    ];
---
<section class="relative overflow-hidden pt-36 pb-32 md:pt-52 md:pb-44 min-h-[88vh] flex items-center">
  <div class="absolute inset-0 -z-10">
    <video
      class="w-full h-full object-cover opacity-42"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-bg.jpg"
    >
      <source src="/videos/hero-ambient.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-0)]/35 via-[var(--color-abyss-0)]/60 to-[var(--color-abyss-1)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[var(--color-abyss-1)] to-transparent"></div>
  </div>

  <div class="relative max-w-[1280px] mx-auto px-6 grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-7 relative z-10">
      <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-7 anim-rise">
        {eyebrow}
      </div>
      <h1 class="font-display text-balance text-5xl md:text-7xl lg:text-[5.5rem] font-bold leading-[1.04] text-[var(--color-paper)] mb-8 tracking-tight anim-rise delay-150">
        {h1}
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-paper)]/85 max-w-2xl mb-10 leading-relaxed anim-rise delay-300">
        {sub}
      </p>
      <div class="flex flex-wrap items-center gap-4 anim-rise delay-500">
        <a href="#benchmarks" class="btn-lumen">
          {t('cta.demos')}
          <span aria-hidden="true">→</span>
        </a>
        <a href="#contact" class="btn-ghost">{t('cta.contact')}</a>
      </div>

    </div>

    <div class="lg:col-span-5 relative anim-rise delay-700">
      <div class="border border-[var(--color-border-deep)] bg-[var(--color-abyss-0)]/72 backdrop-blur-md">
        <div class="font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-lumen)] border-b border-[var(--color-border-deep)] px-5 py-4">
          {t('hero.sonarLabel')}
        </div>
        {metrics.map((m) => (
          <div class="grid grid-cols-[7rem_1fr] gap-5 border-b last:border-b-0 border-[var(--color-border-deep)] px-5 py-6">
            <div class="font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]">{m.label}</div>
            <div>
              <div class="font-mono text-3xl md:text-4xl font-bold text-[var(--color-lumen)] leading-none">{m.value}</div>
              <div class="mt-2 font-mono text-[11px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]">{m.detail}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
