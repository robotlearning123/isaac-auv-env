---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      subtitle: '面向水下机器人的海洋仿真基础设施',
      body: '用可控、可复现、可扩展的虚拟海洋，加速水下机器人的研发、测试、验证与部署迭代。',
    }
  : {
      subtitle: 'The ocean simulator for underwater robotics',
      body: 'A controllable, reproducible virtual ocean that accelerates development, testing, validation, and deployment iteration for underwater robots.',
    };
---
<section class="home-hero relative min-h-screen overflow-hidden bg-[var(--color-bg)]">
  <video
    class="home-hero__video"
    data-background-video
    aria-hidden="true"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/oceanscale-hero-bg-keyframe.png"
  >
    <source src="/videos/oceanscale-hero-training-motion.mp4" type="video/mp4" />
  </video>

  <div class="home-hero__shade"></div>

  <div class="home-hero__content reveal">
    <h1>OceanScale</h1>
    <p class="home-hero__subtitle">{copy.subtitle}</p>
    <p class="home-hero__body">{copy.body}</p>
  </div>
</section>

<style is:global>
  .home-hero {
    display: grid;
    place-items: end start;
    padding: clamp(6rem, 14vw, 12rem) clamp(1.25rem, 4vw, 4rem);
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.98;
  }

  .home-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.92) 0%, rgba(3, 7, 12, 0.56) 36%, rgba(3, 7, 12, 0.08) 72%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 28%),
      linear-gradient(180deg, rgba(3, 7, 12, 0.45) 0%, rgba(3, 7, 12, 0) 30%);
    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .home-hero__content h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 7.5rem;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0;
    text-shadow: 0 18px 80px rgba(0, 0, 0, 0.5);
  }

  .home-hero__subtitle {
    margin: clamp(1rem, 2vw, 1.4rem) 0 0;
    max-width: 760px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 2rem;
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: 0;
    text-shadow: 0 12px 50px rgba(0, 0, 0, 0.55);
  }

  .home-hero__body {
    margin: 0.95rem 0 0;
    max-width: 680px;
    color: rgba(235, 242, 247, 0.76);
    font-size: 1.16rem;
    font-weight: 500;
    line-height: 1.58;
    letter-spacing: 0;
    text-shadow: 0 12px 46px rgba(0, 0, 0, 0.58);
  }

  html[lang="zh"] .home-hero__content h1 {
    font-family: var(--font-display);
  }

  html[lang="zh"] .home-hero__subtitle,
  html[lang="zh"] .home-hero__body {
    font-family: var(--font-display-zh);
  }

  @media (max-width: 768px) {
    .home-hero {
      display: block;
      min-height: auto;
      padding: calc(56.25vw + 2.5rem) 1.25rem 4.25rem;
    }

    .home-hero__video {
      inset: 0 0 auto;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: contain;
      object-position: top center;
    }

    .home-hero__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0) 0%, rgba(3, 7, 12, 0.28) 32%, var(--color-bg) 66%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .home-hero__content h1 {
      font-size: 3.65rem;
      max-width: calc(100vw - 2.5rem);
    }

    .home-hero__subtitle {
      font-size: 1.35rem;
      max-width: calc(100vw - 2.5rem);
      line-height: 1.2;
    }

    .home-hero__body {
      font-size: 1rem;
      line-height: 1.58;
      max-width: calc(100vw - 2.5rem);
    }
  }

  @media (min-width: 1440px) {
    .home-hero__content h1 {
      font-size: 8.75rem;
    }

    .home-hero__subtitle {
      font-size: 2.25rem;
    }

    .home-hero__body {
      font-size: 1.22rem;
    }
  }

  @media (max-width: 1100px) and (min-width: 769px) {
    .home-hero__content h1 {
      font-size: 5.75rem;
    }

    .home-hero__subtitle {
      font-size: 1.6rem;
    }
  }
</style>
