---
import zhData from '../content/zh/hero';
import enData from '../content/en/hero';
import zhStats from '../content/zh/stats';
import enStats from '../content/en/stats';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hero = lang === 'zh' ? zhData : enData;
const stats = lang === 'zh' ? zhStats : enStats;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
---
<!-- SCREEN 1: Full-viewport hero with video background -->
<section class="relative min-h-screen flex items-end pb-16" style="background: var(--color-bg);">
  <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover opacity-40" poster="/images/hero-impact.webp">
    <source src="/videos/hero-storm.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0" style="background: linear-gradient(to top, var(--color-bg) 0%, rgba(6,11,18,0.6) 40%, rgba(6,11,18,0.3) 100%);"></div>
  
  <div class="os-container relative z-10">
    <div class="os-kicker mb-6">{hero.eyebrow}</div>
    <h1 class="os-h1" style="max-width: 16ch; font-size: clamp(3rem, 8vw, 6.5rem);">
      {strip(hero.h1)}
    </h1>
    <p class="mt-6 text-lg md:text-xl max-w-xl" style="color: var(--color-text-muted); line-height: 1.6;">
      {hero.enemyLine}
    </p>
    <div class="flex gap-4 mt-8">
      <a href="#benchmarks" class="os-btn os-btn--primary">
        {t('cta.demos')} <span aria-hidden="true">&rarr;</span>
      </a>
      <a href="#contact" class="os-btn os-btn--ghost">{t('cta.contact')}</a>
    </div>
  </div>
</section>

<!-- SCREEN 2: Terminal proof layer -->
<section class="os-section os-section--surface">
  <div class="os-container" style="max-width: 640px;">
    <p class="mb-6" style="color: var(--color-text-muted); font-size: 1rem; max-width: 52ch;">
      {hero.sub}
    </p>
    <div class="os-terminal">
      <div class="os-terminal__bar">
        <span class="os-terminal__dot os-terminal__dot--red"></span>
        <span class="os-terminal__dot os-terminal__dot--yellow"></span>
        <span class="os-terminal__dot os-terminal__dot--green"></span>
        <span class="os-terminal__title">oceanscale run</span>
      </div>
      <pre><code><span class="prompt">$</span> pip install oceanscale
<span class="prompt">$</span> oceanscale demo bluerov2-hover --envs 64
<span class="muted">sim</span> <span class="bold">17,427 env-steps/s</span>
<span class="muted">model</span> Fossen 6-DoF · Newton+Warp
<span class="muted">status</span> <span class="bold">reproducible benchmark ready</span></code></pre>
    </div>
  </div>
</section>
