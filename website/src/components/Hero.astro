---
import zhData from '../content/zh/hero';
import enData from '../content/en/hero';
import statsZh from '../content/zh/stats';
import statsEn from '../content/en/stats';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const stats: any = lang === 'zh' ? statsZh : statsEn;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
const metrics = stats.items.slice(0, 3);
const isZh = lang === 'zh';
---
<section id="hero" class="landing-section section-dark ">
  <div class="section-inner grid gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
    <div class="relative z-10 max-w-4xl">
      <p class="section-kicker">/00 · {fm.eyebrow}</p>
      <h1 class="hero-title">{cleanHeadline(fm.h1)}</h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-[var(--color-text)] md:text-2xl">
        {fm.enemyLine}
      </p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-text-muted)] md:text-lg">
        {fm.sub}
      </p>

      <div class="mt-10 grid gap-3 sm:grid-cols-3">
        {metrics.map((metric: { value: string; suffix: string; label: string }) => (
          <div class="metric-tile">
            <div class="metric-value">
              {metric.value}<span>{metric.suffix}</span>
            </div>
            <div class="metric-label">{metric.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="relative">
      <div class="media-frame hero-media">
        <video
          src="/videos/hero-storm.mp4"
          poster="/images/hero-impact.webp"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="h-full w-full object-cover"
          aria-label={isZh ? '风暴海面测试影像' : 'Storm test deck footage'}
        ></video>
        <div class="absolute left-4 top-4 rounded-sm border border-[var(--color-border)] bg-[var(--color-bg)]/85 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent)] backdrop-blur">
          RTX 5090 · CUDA 12.9
        </div>
      </div>

      <div class="terminal-panel hero-terminal">
        <div class="terminal-panel__bar">
          <span></span>
          <span></span>
          <span></span>
          <strong>oceanscale run</strong>
        </div>
        <pre><code><span class="terminal-prompt">$</span> pip install oceanscale
<span class="terminal-muted">collecting oceanscale</span>
<span class="terminal-prompt">$</span> oceanscale demo bluerov2-hover --envs 64
<span class="terminal-muted">sim</span> 17,427 env-steps/s
<span class="terminal-muted">model</span> Fossen 6-DoF · Newton+Warp
<span class="terminal-muted">status</span> reproducible benchmark ready</code></pre>
      </div>
    </div>
  </div>
</section>
