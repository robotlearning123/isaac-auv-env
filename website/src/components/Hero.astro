---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const tagline = isZh
  ? '面向水下机器人的 AI 原生仿真基础设施'
  : 'AI-native simulation infrastructure for underwater robotics';
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden" style="background: var(--color-bg);">
  <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover opacity-40" poster="/images/hero-impact.webp">
    <source src="/videos/hero-storm.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0" style="background: linear-gradient(to top, var(--color-bg) 0%, var(--color-bg) 15%, rgba(6,11,18,0.7) 40%, rgba(6,11,18,0.25) 100%);"></div>

  <div class="hero-glow"></div>

  <div class="relative z-10 text-center px-6">
    <h1 class="reveal hero-title">
      OceanScale
    </h1>
    <p class="reveal hero-tagline" data-delay="2">
      {tagline}
    </p>
    <div class="reveal hero-scroll-hint" data-delay="4">
      <svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="1" y="1" width="18" height="26" rx="9" />
        <line x1="10" y1="6" x2="10" y2="12" class="hero-scroll-dot" />
      </svg>
    </div>
  </div>
</section>

<style is:global>
  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(900px, 80vw);
    height: 600px;
    background: radial-gradient(ellipse, rgba(45,212,191,0.06) 0%, rgba(45,212,191,0.02) 40%, transparent 70%);
    pointer-events: none;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--color-text);
    text-shadow: 0 0 120px rgba(45,212,191,0.08);
  }

  html[lang="zh"] .hero-title {
    font-family: var(--font-display-zh);
  }

  .hero-tagline {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.2vw, 0.9rem);
    color: var(--color-text-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  html[lang="zh"] .hero-tagline {
    font-family: var(--font-body-zh);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  @media (max-width: 480px) {
    .hero-tagline {
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }
  }

  .hero-scroll-hint {
    margin-top: 4rem;
    color: var(--color-text-muted);
    opacity: 0.4;
  }

  .hero-scroll-dot {
    animation: scroll-bob 2s ease-in-out infinite;
  }

  @keyframes scroll-bob {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(4px); opacity: 0.3; }
  }
</style>
