---
import zhData from '../content/zh/why';
import enData from '../content/en/why';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
const captions =
  lang === 'zh'
    ? ['现场窗口不可排队', '仿真与海试之间的差距']
    : ['Field windows do not queue', 'The field-versus-sim gap'];
---
<section id="why" class="landing-section section-light">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-kicker">/01 · {fm.eyebrow}</p>
      <h2 class="section-title">{cleanHeadline(fm.title)}</h2>
      <p class="section-copy">{fm.label}</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <figure class="media-frame">
        <img
          src="/images/challenge-vessel.webp"
          alt={lang === 'zh' ? '海上船只俯拍照片' : 'Aerial vessel field-test photo'}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <figcaption>{captions[0]}</figcaption>
      </figure>
      <figure class="media-frame">
        <img
          src="/images/challenge-whiteboard.webp"
          alt={lang === 'zh' ? '现场与仿真白板图' : 'Field versus simulation whiteboard'}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <figcaption>{captions[1]}</figcaption>
      </figure>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {fm.problems.map((problem: { title: string; body: string }, index: number) => (
        <article class="landing-card">
          <div class="card-index">{String(index + 1).padStart(2, '0')}</div>
          <h3>{cleanHeadline(problem.title)}</h3>
          <p>{problem.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
