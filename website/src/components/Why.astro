---
import zhData from '../content/zh/why';
import enData from '../content/en/why';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, problems } = fm;
---
<section id="why" class="relative overflow-hidden py-24 md:py-32 min-h-screen flex items-center section-cool">
  <div class="absolute inset-0 -z-10">
    <img src="/images/why-bg.jpg" alt="" class="w-full h-full object-cover opacity-22 grayscale-[0.25]" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-abyss-0)] via-[var(--color-abyss-0)]/90 to-[var(--color-steel)]/70"></div>
  </div>
  <div class="relative max-w-[1320px] mx-auto px-5 md:px-8 w-full grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-end">
    <div>
      <div class="font-mono text-[var(--color-acid)] text-xs uppercase eyebrow-tracking mb-4">/01 · {eyebrow}</div>
      <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-black text-[var(--color-paper)] tracking-tight max-w-3xl leading-[0.98]">{title}</h2>
      <div class="mt-10 hidden lg:block font-mono text-[11px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]">
        Iteration cost / ocean robotics AI
      </div>
    </div>

    <ol class="challenge-stack list-none">
      {problems.map((p: { title: string; body: string }, i: number) => (
        <li class="challenge-row">
          <div class="font-mono text-[var(--color-acid)] text-sm">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <h3 class="font-display text-2xl md:text-3xl font-black text-[var(--color-paper)] leading-tight">{p.title}</h3>
            <p class="mt-3 text-[var(--color-paper-dim)] leading-relaxed text-sm md:text-base max-w-xl">{p.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
