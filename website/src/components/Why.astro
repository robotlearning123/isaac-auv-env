---
import zhData from '../content/zh/why';
import enData from '../content/en/why';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const fm = lang === 'zh' ? zhData : enData;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
---
<section id="why" class="os-section os-section--dark os-section--bg-why">
  <div class="os-container os-centered">
    <div class="os-kicker">/01 · {fm.eyebrow}</div>
    <h2 class="os-h2">{strip(fm.title)}</h2>
    <p class="os-body os-body--centered">{fm.label}</p>
  </div>
  <div class="os-container">
    <figure class="os-frame--hero os-frame--inset">
      <img src="/images/challenge-whiteboard.webp" alt={lang === 'zh' ? '现场测试 vs 仿真验证' : 'Field testing vs simulation validation'} loading="lazy" />
    </figure>
  </div>
</section>
