---
import zhData from '../content/zh/why';
import enData from '../content/en/why';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, problems } = fm;
---
<section id="why" class="relative max-w-[1280px] mx-auto px-6 py-24 md:py-32">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase tracking-[0.3em] mb-3">/01 · Why</div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-16 tracking-tight max-w-4xl">{title}</h2>

  <ol class="space-y-10 list-none">
    {problems.map((p: { title: string; body: string }, i: number) => (
      <li class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-12 items-start py-8 border-t border-[var(--color-border-deep)]">
        <div class="font-mono text-6xl md:text-8xl text-[var(--color-border-deep)] font-bold leading-none select-none">
          {String(i + 1).padStart(2, '0')}
        </div>
        <div class="max-w-3xl">
          <h3 class="font-display text-2xl md:text-3xl font-semibold text-[var(--color-paper)] mb-4 leading-snug">
            {p.title}
          </h3>
          <p class="text-[var(--color-paper-dim)] leading-relaxed text-base md:text-lg">{p.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
