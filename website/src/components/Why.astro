---
import zhData from '../content/zh/why';
import enData from '../content/en/why';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, problems } = fm;
---
<section id="why" class="relative overflow-hidden py-24 md:py-32 min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/why-bg.jpg" alt="" class="w-full h-full object-cover opacity-25" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)] via-[var(--color-abyss-1)]/88 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 w-full">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3">/01 · {eyebrow}</div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-12 tracking-tight max-w-4xl leading-[1.05]">{title}</h2>

  <ol class="grid md:grid-cols-3 gap-px bg-[var(--color-border-deep)] border border-[var(--color-border-deep)] list-none">
    {problems.map((p: { title: string; body: string }, i: number) => (
      <li class="bg-[var(--color-abyss-1)] p-8 md:p-10 min-h-[17rem] flex flex-col">
        <div class="font-mono text-5xl text-[var(--color-lumen)]/25 font-bold leading-none select-none mb-10">
          {String(i + 1).padStart(2, '0')}
        </div>
        <h3 class="font-display text-2xl font-semibold text-[var(--color-paper)] mb-4 leading-tight">
          {p.title}
        </h3>
        <p class="text-[var(--color-paper-dim)] leading-relaxed text-sm max-w-sm">{p.body}</p>
      </li>
    ))}
  </ol>
  </div>
</section>
