---
import zhData from '../content/zh/builton';
import enData from '../content/en/builton';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { eyebrow, title, intro, partners } = fm;
---
<section class="relative overflow-hidden min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/builton-bg.jpg" alt="" class="w-full h-full object-cover opacity-25" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)]/85 via-[var(--color-abyss-1)]/85 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 py-24 md:py-32 w-full">
  <div class="grid lg:grid-cols-12 gap-10 mb-12">
    <div class="lg:col-span-5">
      <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3">/04 · {eyebrow}</div>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-[var(--color-paper)] tracking-tight mb-5 leading-[1.05]">{title}</h2>
    </div>
    <div class="lg:col-span-7 flex items-center">
      <p class="text-[var(--color-paper-dim)] leading-relaxed text-base md:text-lg max-w-2xl">{intro}</p>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-px bg-[var(--color-border-deep)] border border-[var(--color-border-deep)]">
    {partners.map((p: { name: string; note: string }) => (
      <div class="card-glow bg-[var(--color-abyss-1)] p-6 hover:bg-[var(--color-abyss-2)] group min-h-[6.5rem] flex flex-col justify-between">
        <div class="font-display text-xl md:text-2xl font-bold text-[var(--color-paper)] tracking-tight group-hover:text-[var(--color-lumen)] transition-colors leading-none">{p.name}</div>
        <div class="font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)] mt-3 leading-relaxed">{p.note}</div>
      </div>
    ))}
  </div>
  </div>
</section>
