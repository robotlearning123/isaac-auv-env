---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const heading = isZh ? '从 Alpha 到海上验证。' : 'From alpha to ocean validation.';

const phases = isZh ? [
  { label: 'Now', title: '核心仿真内核', items: ['GPU 原生动力学', '多机器人并行 rollout', '基础传感器与任务 API'] },
  { label: 'Next', title: '机器人和任务扩展', items: ['更多形态的水下机器人', '机械臂和工具交互', '复杂地形和海况随机化'] },
  { label: 'Later', title: 'Sim2Real 基准', items: ['真实海试数据对齐', '策略回放和失败分析', '团队协作和报告管线'] },
] : [
  { label: 'Now', title: 'Core simulator', items: ['GPU-native dynamics', 'Parallel multi-robot rollouts', 'Sensor and task APIs'] },
  { label: 'Next', title: 'Robots and tasks', items: ['More underwater robot morphologies', 'Manipulator and tool interaction', 'Complex terrain and ocean randomization'] },
  { label: 'Later', title: 'Sim2Real benchmarks', items: ['Field-data alignment', 'Policy replay and failure analysis', 'Team reporting pipeline'] },
];
---
<section id="roadmap" class="roadmap-section">
  <div class="os-container">
    <div class="roadmap-section__head reveal">
      <p class="section-label">Roadmap</p>
      <h2>{heading}</h2>
    </div>

    <div class="roadmap-section__grid">
      {phases.map((phase, index) => (
        <article class="roadmap-card reveal" data-delay={String(index + 1)}>
          <span>{phase.label}</span>
          <h3>{phase.title}</h3>
          <ul>
            {phase.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .roadmap-section {
    padding: clamp(5rem, 9vw, 8rem) 0;
    background:
      linear-gradient(180deg, #060b12 0%, #08111a 44%, #060b12 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .roadmap-section__head {
    max-width: 680px;
  }

  .roadmap-section__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.6vw, 4.15rem);
    font-weight: 900;
    line-height: 1.03;
    letter-spacing: 0;
    text-wrap: balance;
  }

  html[lang="zh"] .roadmap-section__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .roadmap-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2.1rem, 4vw, 3.4rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.12);
  }

  .roadmap-card {
    min-height: 280px;
    padding: clamp(1.3rem, 2.5vw, 2rem);
    background: rgba(6, 11, 18, 0.78);
  }

  .roadmap-card span {
    display: inline-flex;
    color: rgba(45, 212, 191, 0.94);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .roadmap-card h3 {
    margin: 1.15rem 0 0;
    color: #fff;
    font-size: 1.3rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .roadmap-card ul {
    display: grid;
    gap: 0.85rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-card li {
    position: relative;
    padding-left: 1.05rem;
    color: rgba(232, 237, 243, 0.68);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .roadmap-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(45, 212, 191, 0.8);
  }

  @media (max-width: 820px) {
    .roadmap-section__head h2 {
      font-size: 2.45rem;
      line-height: 1.08;
    }

    .roadmap-section__grid {
      grid-template-columns: 1fr;
    }

    .roadmap-card {
      min-height: auto;
    }
  }

  @media (min-width: 1440px) {
    .roadmap-section__head h2 {
      font-size: 4.25rem;
    }
  }
</style>
