---
import zhData from '../content/zh/benchmarks';
import enData from '../content/en/benchmarks';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, headers, rows, caveat } = fm;
---
<section id="benchmarks" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10">
    <img src="/images/benchmarks-bg.jpg" alt="" class="w-full h-full object-cover opacity-25" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)] via-[var(--color-abyss-1)]/88 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3">/06 · {eyebrow}</div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-12 tracking-tight max-w-4xl">{title}</h2>

  <div class="overflow-x-auto border border-[var(--color-border-deep)]">
    <table class="w-full text-left text-sm min-w-[680px]">
      <thead class="bg-[var(--color-abyss-1)]">
        <tr>
          {headers.map((h: string, i: number) => (
            <th class:list={[
              "px-4 py-4 font-mono uppercase tracking-[0.15em] text-[11px]",
              i === 1 ? "text-[var(--color-lumen)]" : "text-[var(--color-paper-dim)]"
            ]}>
              {h}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row: string[]) => (
          <tr class="border-t border-[var(--color-border-deep)] hover:bg-[var(--color-abyss-1)]/40 transition-colors">
            {row.map((cell: string, i: number) => (
              <td class:list={[
                "px-4 py-3",
                i === 0 ? "text-[var(--color-paper)]" :
                i === 1 ? "text-[var(--color-lumen)] font-mono font-semibold bg-[var(--color-lumen)]/[0.04]" :
                "text-[var(--color-paper-dim)] font-mono"
              ]} set:html={cell.replace(/\*\*(.+?)\*\*/g, '<strong class="text-[var(--color-paper)]">$1</strong>')}>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caveat && (
    <p class="mt-5 text-xs text-[var(--color-paper-dim)] italic max-w-2xl leading-relaxed">{caveat}</p>
  )}
  </div>
</section>
