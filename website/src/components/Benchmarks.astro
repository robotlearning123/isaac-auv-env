---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const content = isZh ? {
  label: 'Benchmarks',
  title: '把训练结果变成可复现证据。',
  titleLines: ['把训练结果', '变成可复现证据。'],
  body: '每个策略都需要在任务、传感器、扰动和失败边界上重复验证。OceanScale 的基准环境把仿真吞吐转化为可以比较的工程证据。',
  stats: [
    ['Tasks', '对接、悬停、巡检'],
    ['Worlds', '洋流、能见度、地形'],
    ['Reports', '轨迹和失败回放'],
  ],
} : {
  label: 'Benchmarks',
  title: 'Turn training into repeatable evidence.',
  body: 'Every policy needs repeatable evidence across tasks, sensors, disturbances, and failure boundaries. OceanScale turns simulation throughput into comparable engineering proof.',
  stats: [
    ['Tasks', 'docking, hover, survey'],
    ['Worlds', 'currents, visibility, terrain'],
    ['Reports', 'trajectories and failure replay'],
  ],
};
---
<section id="benchmarks" class="cinematic-section cinematic-section--left">
  <video
    class="cinematic-section__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-evidence-validation.png"
  >
    <source src="/videos/oceanscale-evidence-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="cinematic-section__shade"></div>

  <div class="cinematic-section__inner reveal">
    <p class="section-label">{content.label}</p>
    <h2>
      {'titleLines' in content
        ? content.titleLines.map((line) => <span>{line}</span>)
        : content.title}
    </h2>
    <p class="section-body">{content.body}</p>
    <div class="section-stats" aria-label={isZh ? '基准指标' : 'Benchmark metrics'}>
      {content.stats.map(([label, value]) => (
        <div>
          <span>{label}</span>
          <strong>{value}</strong>
        </div>
      ))}
    </div>
  </div>
</section>
