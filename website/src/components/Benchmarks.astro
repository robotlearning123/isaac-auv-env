---
import zhData from '../content/zh/benchmarks';
import enData from '../content/en/benchmarks';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, headers, rows, caveat } = fm;
const topMetrics = [
  { value: '11,435', label: 'Single-env FPS' },
  { value: '90M', label: 'env-steps/s' },
  { value: '8192', label: 'parallel envs' },
];
---
<section id="benchmarks" class="relative overflow-hidden py-24 md:py-32 min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/benchmarks-bg.jpg" alt="" class="w-full h-full object-cover opacity-22 grayscale-[0.2]" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-abyss-0)] via-[var(--color-abyss-0)]/88 to-[var(--color-steel)]/78"></div>
  </div>
  <div class="relative max-w-[1320px] mx-auto px-5 md:px-8 w-full">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-12">
      <div>
        <div class="font-mono text-[var(--color-acid)] text-xs uppercase eyebrow-tracking mb-4">/03 · {eyebrow}</div>
        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-black text-[var(--color-paper)] tracking-tight max-w-4xl leading-[0.98]">{title}</h2>
      </div>
      <div class="grid grid-cols-3 border border-[var(--color-border-deep)] bg-[var(--color-abyss-0)]/62 backdrop-blur-md min-w-full lg:min-w-[34rem]">
        {topMetrics.map((m) => (
          <div class="p-4 md:p-5 border-r last:border-r-0 border-[var(--color-border-deep)]">
            <div class="font-mono text-2xl md:text-4xl font-bold text-[var(--color-acid)] leading-none">{m.value}</div>
            <div class="mt-2 font-mono text-[9px] md:text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="relative overflow-x-auto border border-[var(--color-border-deep)] bg-[var(--color-abyss-0)]/72 backdrop-blur-md shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
      <table class="w-full text-left text-sm min-w-[760px] border-collapse">
        <thead>
          <tr class="bg-[var(--color-abyss-1)]">
            {headers.map((h: string, i: number) => (
              <th class:list={[
                'px-5 py-5 font-mono uppercase tracking-[0.15em] text-[11px] align-bottom',
                i === 0 ? 'text-[var(--color-paper-dim)] w-[34%]' :
                i === 1 ? 'text-[var(--color-abyss-0)] bg-[var(--color-acid)] relative' :
                'text-[var(--color-paper-dim)]'
              ]}>
                {i === 1 ? (
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-abyss-0)]"></span>
                    {h}
                  </span>
                ) : h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row: string[], ri: number) => (
            <tr class:list={[
              'border-t border-[var(--color-border-deep)] transition-colors',
              ri % 2 === 1 ? 'bg-[var(--color-abyss-0)]/30' : '',
              'hover:bg-[var(--color-abyss-2)]/40'
            ]}>
              {row.map((cell: string, i: number) => (
                <td class:list={[
                  'px-5 py-4 align-middle',
                  i === 0 ? 'text-[var(--color-paper)] font-medium' :
                  i === 1 ? 'text-[var(--color-acid)] font-mono font-semibold bg-[var(--color-acid)]/[0.06] border-l border-r border-[var(--color-acid)]/30 text-base' :
                  'text-[var(--color-paper-dim)] font-mono'
                ]} set:html={cell.replace(/\*\*(.+?)\*\*/g, '<strong class="text-[var(--color-paper)] text-base">$1</strong>')}>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {caveat && (
      <p class="mt-6 text-xs text-[var(--color-paper-dim)] max-w-2xl leading-relaxed border-l-2 border-[var(--color-border-deep)] pl-4">{caveat}</p>
    )}
  </div>
</section>
