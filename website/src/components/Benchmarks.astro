---
import zhData from '../content/zh/benchmarks';
import enData from '../content/en/benchmarks';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
const renderEmphasis = (value: string) =>
  value.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<section id="benchmarks" class="landing-section section-light">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-kicker">/03 · {fm.eyebrow}</p>
      <h2 class="section-title">{cleanHeadline(fm.title)}</h2>
      <p class="section-copy">{fm.caveat}</p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr] xl:items-start">
      <div class="table-shell mobile-scroll-hint">
        <table>
          <thead>
            <tr>
              {fm.headers.map((header: string, index: number) => (
                <th class={index === fm.headers.length - 1 ? 'is-oceanscale' : ''}>{header}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {fm.rows.map((row: string[]) => (
              <tr>
                {row.map((cell: string, index: number) => (
                  index === 0 ? (
                    <th scope="row" set:html={renderEmphasis(cell)}></th>
                  ) : (
                    <td class={index === row.length - 1 ? 'is-oceanscale' : ''} set:html={renderEmphasis(cell)}></td>
                  )
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="space-y-4">
        <figure class="media-frame">
          <img
            src="/images/bench-landscape.webp"
            alt={lang === 'zh' ? '水下仿真竞争格局白板' : 'Underwater simulation competitive landscape whiteboard'}
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <figcaption>{lang === 'zh' ? '竞争格局 · GPU 速度与水下保真度' : 'Competitive landscape · GPU speed and underwater fidelity'}</figcaption>
        </figure>
        <p class="evidence-note">{fm.landscapeNote}</p>
      </div>
    </div>
  </div>
</section>
