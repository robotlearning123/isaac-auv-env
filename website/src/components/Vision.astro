---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const heading = isZh
  ? '在仿真中训练，在真实海洋中部署'
  : 'Train in simulation. Deploy in the ocean.';

const points = isZh ? [
  { title: '数千小时，几分钟完成', body: '一台 GPU 可以同时运行数千个水下环境，将数周的现场试验压缩到几小时的仿真。' },
  { title: '每个场景，每种故障', body: '洋流、能见度、传感器噪声、执行器故障 — 在仿真中穷举所有边界条件，而非在海里碰运气。' },
  { title: '从仿真到部署', body: '高保真物理 + 传感器级精度，让策略直接从仿真迁移到真实机器人，减少现场调试。' },
] : [
  { title: 'Thousands of hours in minutes', body: 'A single GPU runs thousands of underwater environments simultaneously, compressing weeks of field trials into hours of simulation.' },
  { title: 'Every scenario, every failure', body: 'Currents, visibility, sensor noise, actuator faults — exhaust edge cases in simulation instead of discovering them at sea.' },
  { title: 'Simulation to deployment', body: 'High-fidelity physics and sensor-accurate simulation enable policies to transfer from sim to real robots with minimal field tuning.' },
];
---
<section id="vision" class="relative py-24 lg:py-32" style="background: var(--color-bg); border-top: 1px solid var(--color-border);">
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 50%, rgba(45,212,191,0.02) 0%, transparent 50%);"></div>

  <div class="os-container relative z-10">
    <p class="vision-kicker">{isZh ? '愿景' : 'VISION'}</p>
    <h2 class="os-h2 vision-heading">{heading}</h2>

    <div class="vision-grid">
      {points.map((p) => (
        <div class="vision-item">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .vision-kicker {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .vision-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem) !important;
    max-width: 24ch;
    margin-bottom: 3.5rem !important;
  }

  html[lang="zh"] .vision-heading {
    font-family: var(--font-display-zh);
    word-break: keep-all;
  }

  .vision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .vision-item {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: rgba(15, 24, 34, 0.5);
  }

  .vision-item h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .vision-item p {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .vision-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
