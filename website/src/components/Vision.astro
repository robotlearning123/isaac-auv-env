---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const content = isZh ? {
  label: 'Solution',
  title: '先在虚拟海洋中训练。',
  titleLines: ['先在虚拟海洋中', '训练。'],
  body: 'OceanScale 把海流、地形、传感器、执行器和任务约束放进同一个 GPU 原生仿真环境，让机器人在进入真实海洋前完成大规模并行训练。',
  stats: [
    ['Scale', '数千并行环境'],
    ['Physics', '水动力和接触'],
    ['Transfer', '面向实机验证'],
  ],
} : {
  label: 'Solution',
  title: 'Train first in a virtual ocean.',
  titleLines: ['Train first', 'in a virtual ocean.'],
  body: 'OceanScale brings currents, terrain, sensors, actuators, and task constraints into one GPU-native simulator, so underwater robots can train at scale before touching the ocean.',
  stats: [
    ['Scale', 'thousands of rollouts'],
    ['Physics', 'hydrodynamics and contact'],
    ['Transfer', 'built for real validation'],
  ],
};
---
<section id="solution" class="cinematic-section cinematic-section--right">
  <video
    class="cinematic-section__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="cinematic-section__shade"></div>

  <div class="cinematic-section__inner reveal">
    <div class="cinematic-section__copy">
      <p class="section-label">{content.label}</p>
      <h2>
        {'titleLines' in content
          ? content.titleLines.map((line) => <span>{line}</span>)
          : content.title}
      </h2>
      <p class="section-body">{content.body}</p>
      <div class="section-stats" aria-label={isZh ? '解决方案指标' : 'Solution metrics'}>
        {content.stats.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
