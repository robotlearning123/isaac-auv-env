---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh';
---
<footer class="relative z-10 border-t border-[var(--color-border-deep)] mt-32">
  <div class="max-w-[1280px] mx-auto px-6 py-12 grid gap-8 md:grid-cols-[1fr_auto] items-center">
    <div>
      <div class="font-display text-2xl text-[var(--color-paper)] mb-1">
        {isZh ? '沧渊' : 'OceanScale'}
      </div>
      <div class="text-[var(--color-paper-dim)] text-sm">{t('footer.tagline')}</div>
    </div>
    <div class="font-mono text-xs text-[var(--color-paper-dim)] md:text-right">
      {t('footer.copyright')}
    </div>
  </div>
</footer>
