---
import zhData from '../content/zh/contact';
import enData from '../content/en/contact';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
---
<section id="contact" class="landing-section section-light">
  <div class="section-inner grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div>
      <p class="section-kicker">/05 · {fm.eyebrow}</p>
      <h2 class="section-title">{cleanHeadline(fm.title)}</h2>
      <p class="section-copy">{fm.intro}</p>

      <div class="mt-8 grid gap-3">
        {fm.emails.map((entry: { label: string; email: string }) => (
          <a href={'mailto:' + entry.email} class="contact-link">
            <span>{entry.label}</span>
            <strong>{entry.email}</strong>
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <figure class="media-frame contact-image">
        <img
          src="/images/hero-impact.webp"
          alt={lang === 'zh' ? '风暴甲板照片' : 'Storm deck photo'}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <figcaption>{lang === 'zh' ? '从现场试验到可重复仿真' : 'From field trials to reproducible simulation'}</figcaption>
      </figure>

      <div class="terminal-panel">
        <div class="terminal-panel__bar">
          <span></span>
          <span></span>
          <span></span>
          <strong>package install</strong>
        </div>
        <pre><code><span class="terminal-prompt">$</span> pip install oceanscale
<span class="terminal-muted">Successfully installed</span> oceanscale-0.0.2
<span class="terminal-prompt">$</span> python -c "import oceanscale as os"
<span class="terminal-muted">ready</span> simulation loop online</code></pre>
      </div>
    </div>
  </div>
</section>
