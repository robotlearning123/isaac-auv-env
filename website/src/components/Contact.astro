---
import zhData from '../content/zh/contact';
import enData from '../content/en/contact';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, intro, emails } = fm;
---
<section id="contact" class="relative overflow-hidden min-h-screen flex items-center text-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/contact-bg.jpg" alt="" class="w-full h-full object-cover opacity-30" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)]/70 via-[var(--color-abyss-1)]/85 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 py-24 md:py-32 w-full">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-3 inline-flex items-center gap-3">
    <span class="w-8 h-px bg-[var(--color-lumen)]"></span>
    /04 · {eyebrow}
    <span class="w-8 h-px bg-[var(--color-lumen)]"></span>
  </div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-6 tracking-tight">{title}</h2>
  <p class="text-[var(--color-paper-dim)] max-w-2xl mx-auto mb-12 leading-relaxed">{intro}</p>

  <div class="grid md:grid-cols-3 gap-px bg-[var(--color-border-deep)] border border-[var(--color-border-deep)] max-w-4xl mx-auto text-left">
    {emails.map((e: { label: string; email: string }) => (
      <a href={`mailto:${e.email}`} class="bg-[var(--color-abyss-1)] hover:bg-[var(--color-abyss-2)] transition-colors p-6">
        <span class="block font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-lumen)]/80 mb-4">{e.label}</span>
        <span class="font-mono text-sm text-[var(--color-paper)] break-all">{e.email}</span>
      </a>
    ))}
  </div>

</section>
