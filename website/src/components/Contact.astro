---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const heading = isZh ? '先在仿真中训练，再进入海洋。' : 'Train in simulation. Then enter the ocean.';
const body = isZh
  ? '如果你正在研发水下机器人、海洋任务策略或仿真基础设施，可以把机器人形态、任务和验证目标发给我们。'
  : 'If you are building underwater robots, ocean mission policies, or simulation infrastructure, send us the robot form factor, task, and validation target.';
const emailLabel = isZh ? '联系 OceanScale' : 'Contact OceanScale';
---
<section id="contact" class="contact-section">
  <div class="contact-section__bg"></div>
  <div class="os-container contact-section__inner reveal">
    <p class="section-label">Contact</p>
    <h2>{heading}</h2>
    <p>{body}</p>
    <a href="mailto:business@oceanscale.cn" class="contact-link">{emailLabel}</a>
  </div>
</section>

<style is:global>
  .contact-section {
    position: relative;
    overflow: hidden;
    min-height: 72vh;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .contact-section__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.92), rgba(3, 7, 12, 0.52), rgba(3, 7, 12, 0.9)),
      url("/images/oceanscale-bg-evidence-validation.png") center / cover no-repeat;
    opacity: 0.9;
  }

  .contact-section__inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
    padding: clamp(5rem, 10vw, 8rem) 0;
  }

  .contact-section__inner h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 4.4rem;
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  html[lang="zh"] .contact-section__inner h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .contact-section__inner > p:last-of-type {
    margin: 1.4rem 0 0;
    max-width: 620px;
    color: rgba(232, 237, 243, 0.75);
    font-size: 1.08rem;
    line-height: 1.66;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 2.3rem;
    padding: 0 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 4px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s, border-color 0.2s;
  }

  .contact-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 760px) {
    .contact-section {
      min-height: auto;
    }

    .contact-section__inner {
      padding: 6rem 0 5rem;
    }

    .contact-section__inner h2 {
      font-size: 2.75rem;
      line-height: 1.08;
    }

    .contact-section__inner > p:last-of-type {
      font-size: 1rem;
      line-height: 1.6;
    }
  }

  @media (min-width: 1440px) {
    .contact-section__inner h2 {
      font-size: 4.9rem;
    }
  }
</style>
