---
import zhData from '../content/zh/contact';
import enData from '../content/en/contact';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, intro, emails } = fm;
---
<section id="contact" class="relative overflow-hidden min-h-screen flex items-center" style="background:var(--color-bg)">
  <div class="relative max-w-[1320px] mx-auto px-5 md:px-8 py-24 md:py-32 w-full grid lg:grid-cols-[1fr_0.9fr] gap-10 lg:gap-16 items-center">
    <div>
      <div class="font-mono text-[var(--color-accent)] text-xs uppercase eyebrow-tracking mb-4">/04 · {eyebrow}</div>
      <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-black text-[var(--color-text)] tracking-tight max-w-4xl leading-[0.98]">{title}</h2>
      <p class="mt-7 text-[var(--color-text-muted)] max-w-2xl leading-relaxed text-base md:text-lg">{intro}</p>
    </div>

    <div class="grid gap-3">
      {emails.map((e: { label: string; email: string }) => (
        <a href={`mailto:${e.email}`} class="contact-link">
          <span>{e.label}</span>
          <strong>{e.email}</strong>
        </a>
      ))}
    </div>
  </div>
</section>
