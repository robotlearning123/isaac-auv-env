---
import zhData from '../content/zh/contact';
import enData from '../content/en/contact';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { title, eyebrow, intro, emails } = fm;
---
<section id="contact" class="relative max-w-[1280px] mx-auto px-6 py-24 md:py-32 text-center">
  <div class="font-mono text-[var(--color-lumen)] text-xs uppercase tracking-[0.3em] mb-3 inline-flex items-center gap-3">
    <span class="w-8 h-px bg-[var(--color-lumen)]"></span>
    /05 · {eyebrow}
    <span class="w-8 h-px bg-[var(--color-lumen)]"></span>
  </div>
  <h2 class="font-display text-4xl md:text-6xl font-bold text-[var(--color-paper)] mb-6 tracking-tight">{title}</h2>
  <p class="text-[var(--color-paper-dim)] max-w-2xl mx-auto mb-12 leading-relaxed">{intro}</p>

  <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto mb-8">
    {emails.map((e: { label: string; email: string }) => (
      <a
        href={`mailto:${e.email}`}
        class="border border-[var(--color-border-deep)] p-6 hover:border-[var(--color-lumen)] hover:bg-[var(--color-lumen)]/5 transition-all group"
      >
        <div class="font-mono text-[10px] text-[var(--color-lumen)] uppercase tracking-[0.2em] mb-3">{e.label}</div>
        <div class="font-mono text-sm text-[var(--color-paper)] group-hover:text-[var(--color-lumen)] transition-colors break-all">{e.email}</div>
      </a>
    ))}
  </div>

</section>
