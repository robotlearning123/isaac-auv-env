---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const videoSrc = '/videos/oceanscale-evidence-training-motion.mp4';
const posterSrc = '/images/oceanscale-bg-evidence-validation.png';
const copy = isZh
  ? {
      eyebrow: '验证',
      titleLines: ['从一次任务到', '成千上万次实验'],
      body: '同一个机器人模型、同一组海况参数、同一套任务目标，可以在虚拟海洋中反复运行、比较和复盘。验证不再只依赖少数昂贵的现场机会。',
      videoAria: '水下机器人虚拟海洋任务验证视频',
    }
  : {
      eyebrow: 'Validation',
      titleLines: ['From one mission', 'to thousands of experiments'],
      body: 'The same robot model, ocean conditions, and task goals can be run, compared, and replayed repeatedly in the virtual ocean. Validation is no longer limited to a few expensive field opportunities.',
      videoAria: 'Virtual ocean validation video for an underwater robot mission',
    };
---

<section id="demo" class="robot-demo">
  <div class="os-container">
    <div class="robot-demo__header reveal">
      <div class="robot-demo__title-block">
        <p class="section-label">{copy.eyebrow}</p>
        <h2 class="robot-demo__title">
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p class="robot-demo__body">{copy.body}</p>
    </div>

    <div class="robot-demo__media reveal" data-delay="1">
      <video
        src={videoSrc}
        poster={posterSrc}
        aria-label={copy.videoAria}
        data-background-video
        muted
        loop
        autoplay
        playsinline
        preload="auto"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>

  </div>
</section>

<style>
  .robot-demo {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 92px;
    padding: clamp(136px, 13vw, 176px) 0 clamp(72px, 10vw, 132px);
    background: #04101a;
    color: var(--color-text);
    border-top: 1px solid rgba(180, 216, 206, 0.14);
    border-bottom: 1px solid rgba(180, 216, 206, 0.14);
  }

  .robot-demo::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(140deg, rgba(5, 16, 26, 0.86), rgba(6, 9, 16, 0.48), rgba(6, 9, 16, 0.82)),
      url("/images/demos-bg.jpg") center / cover no-repeat;
    opacity: 0.9;
    z-index: 0;
  }

  .robot-demo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 76% 18%, rgba(45, 212, 191, 0.13), transparent 40%),
      linear-gradient(0deg, rgba(3, 7, 12, 0.68), rgba(3, 7, 12, 0.14) 38%, rgba(3, 7, 12, 0.68));
    z-index: 1;
    pointer-events: none;
  }

  .robot-demo > .os-container {
    position: relative;
    z-index: 2;
  }

  .robot-demo__header {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 0.74fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(28px, 5vw, 56px);
  }

  .robot-demo__title-block {
    min-width: 0;
  }

  .robot-demo__title {
    max-width: 17ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.4vw, 4.35rem);
    font-weight: 850;
    line-height: 1.03;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .robot-demo__title span {
    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }

  html[lang="zh"] .robot-demo__title {
    max-width: 16ch;
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .robot-demo__body {
    margin: 0 0 0.35rem;
    max-width: 560px;
    color: rgba(232, 237, 243, 0.74);
    font-size: 1.03rem;
    line-height: 1.68;
  }

  .robot-demo__media {
    overflow: hidden;
    border: 1px solid rgba(180, 216, 206, 0.20);
    border-radius: 8px;
    background: #020707;
  }

  .robot-demo__media video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .robot-demo__evidence {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 0 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .robot-demo__status {
    color: var(--color-accent);
  }

  .robot-demo__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .robot-demo__links a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(180, 216, 206, 0.42);
  }

  .robot-demo__links a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 980px) {
    .robot-demo__header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    .robot-demo {
      scroll-margin-top: 84px;
      padding: 96px 0 84px;
    }

    .robot-demo__title {
      max-width: 100%;
      font-size: 2.05rem;
      line-height: 1.08;
    }

    .robot-demo__body {
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .robot-demo__evidence {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
