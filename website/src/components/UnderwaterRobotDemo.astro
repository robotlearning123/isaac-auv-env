---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const videoSrc = '/videos/oceanscale-underwater-robot-demo.mp4';
const posterSrc = '/images/oceanscale-underwater-robot-demo.png';
const manifestHref = '/demo/underwater_robot_demo_manifest.json';

const copy = isZh
  ? {
      eyebrow: 'Validation',
      titleLines: ['仿真验证'],
      body: '基于水下机器人动力学模型的对接任务，视频、轨迹与验证证据来自同一次仿真输出。',
      videoAria: '水下机器人对接任务仿真验证视频',
      status: 'Evidence: one run',
      manifest: 'Manifest JSON',
      mp4: 'MP4 output',
      metrics: [
        ['任务', 'Autonomous docking'],
        ['模型', 'BlueROV2 Heavy'],
        ['轨迹', '24 frames'],
        ['收敛距离', '0.136 m'],
      ],
    }
  : {
      eyebrow: 'Validation',
      titleLines: ['Simulation Proof'],
      body: 'A docking mission based on an underwater robot dynamics model, with video, trajectory, and verification evidence saved from the same simulation output.',
      videoAria: 'Simulation proof video of an underwater robot docking mission',
      status: 'Evidence: one run',
      manifest: 'Manifest JSON',
      mp4: 'MP4 output',
      metrics: [
        ['Mission', 'Autonomous docking'],
        ['Robot', 'BlueROV2 Heavy'],
        ['Trace', '24 frames'],
        ['Final distance', '0.136 m'],
      ],
    };
---

<section id="demo" class="robot-demo">
  <div class="os-container">
    <div class="robot-demo__header reveal">
      <div class="robot-demo__title-block">
        <p class="section-label">{copy.eyebrow}</p>
        <h2 class="robot-demo__title">
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p class="robot-demo__body">{copy.body}</p>
    </div>

    <div class="robot-demo__media reveal" data-delay="1">
      <video
        src={videoSrc}
        poster={posterSrc}
        aria-label={copy.videoAria}
        muted
        loop
        autoplay
        playsinline
        controls
        preload="metadata"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>

    <div class="robot-demo__evidence reveal" data-delay="2">
      <div class="robot-demo__status">{copy.status}</div>
      <div class="robot-demo__links">
        <a href={manifestHref}>{copy.manifest}</a>
        <a href={videoSrc}>{copy.mp4}</a>
      </div>
    </div>

    <div class="robot-demo__metrics reveal" data-delay="3" aria-label="Underwater robot demo metrics">
      {copy.metrics.map(([label, value]) => (
        <div class="robot-demo__metric">
          <span>{label}</span>
          <strong>{value}</strong>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .robot-demo {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 92px;
    padding: clamp(96px, 12vw, 156px) 0 clamp(72px, 10vw, 132px);
    background: #071414;
    color: var(--color-text);
    border-top: 1px solid rgba(180, 216, 206, 0.14);
    border-bottom: 1px solid rgba(180, 216, 206, 0.14);
  }

  .robot-demo__header {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 0.74fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(28px, 5vw, 56px);
  }

  .robot-demo__title-block {
    min-width: 0;
  }

  .robot-demo__title {
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.4vw, 4.35rem);
    font-weight: 850;
    line-height: 1.03;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .robot-demo__title span {
    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }

  html[lang="zh"] .robot-demo__title {
    max-width: 12ch;
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .robot-demo__body {
    margin: 0 0 0.35rem;
    max-width: 560px;
    color: rgba(232, 237, 243, 0.74);
    font-size: 1.03rem;
    line-height: 1.68;
  }

  .robot-demo__media {
    overflow: hidden;
    border: 1px solid rgba(180, 216, 206, 0.20);
    border-radius: 8px;
    background: #020707;
  }

  .robot-demo__media video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .robot-demo__evidence {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 0 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .robot-demo__status {
    color: var(--color-accent);
  }

  .robot-demo__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .robot-demo__links a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(180, 216, 206, 0.42);
  }

  .robot-demo__links a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .robot-demo__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin-top: clamp(24px, 4vw, 38px);
    border-top: 1px solid rgba(180, 216, 206, 0.18);
    border-bottom: 1px solid rgba(180, 216, 206, 0.18);
  }

  .robot-demo__metric {
    min-width: 0;
    padding: 18px 16px 20px;
    border-right: 1px solid rgba(180, 216, 206, 0.14);
  }

  .robot-demo__metric:last-child {
    border-right: 0;
  }

  .robot-demo__metric span {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .robot-demo__metric strong {
    display: block;
    margin-top: 10px;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .robot-demo__header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    .robot-demo {
      scroll-margin-top: 84px;
      padding: 96px 0 84px;
    }

    .robot-demo__title {
      max-width: 100%;
      font-size: 2.05rem;
      line-height: 1.08;
    }

    .robot-demo__body {
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .robot-demo__evidence {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
