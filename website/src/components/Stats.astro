---
import zhData from '../content/zh/stats';
import enData from '../content/en/stats';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { items } = fm;
const [hero, ...rest] = items as { value: string; suffix: string; label: string }[];
---
<section class="relative overflow-hidden border-y border-[var(--color-border-deep)] min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/stats-bg.jpg" alt="" class="w-full h-full object-cover opacity-15" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)]/80 via-[var(--color-abyss-0)]/75 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 py-20 w-full">
    {/* Top instrument-panel rail */}
    <div class="flex items-end justify-between mb-12 md:mb-20 border-b border-[var(--color-border-deep)] pb-4 gap-6">
      <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking">
        /00 · {lang === 'zh' ? '硬指标' : 'Numbers in production'}
      </div>
      <div class="font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]/70 text-right hidden sm:block">
        RTX 5090 · Newton · Fossen 6-DoF
      </div>
    </div>

    {/* Hero stat full-width — Bloomberg terminal poster */}
    <div class="relative mb-20 md:mb-28">
      <div class="font-mono absolute -top-7 left-0 text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]/60">/01</div>
      <div class="font-mono text-[var(--color-lumen)] font-bold leading-[0.85] tracking-[-0.04em] mb-6"
           style="font-size: clamp(4.5rem, 13vw, 15rem);">
        {hero.value}<span class="text-[0.35em] ml-2 text-[var(--color-lumen)]/70 align-baseline">{hero.suffix}</span>
      </div>
      <div class="font-mono text-xs lg:text-sm uppercase eyebrow-tracking text-[var(--color-paper)] leading-relaxed border-l-2 border-[var(--color-lumen)] pl-4 max-w-2xl">
        {hero.label}
      </div>
    </div>

    {/* Secondary stats — 2 column, smaller but still strong */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-20 pt-12 border-t border-[var(--color-border-deep)]">
      {rest.map((s, i) => (
        <div class="relative">
          <div class="font-mono absolute -top-5 left-0 text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]/60">/0{i + 2}</div>
          <div class="font-mono text-6xl md:text-7xl lg:text-[7rem] text-[var(--color-lumen)] font-bold leading-[0.85] tracking-[-0.03em] mb-3">
            {s.value}<span class="text-[0.4em] ml-1 text-[var(--color-lumen)]/70 align-baseline">{s.suffix}</span>
          </div>
          <div class="font-mono text-[11px] uppercase eyebrow-tracking text-[var(--color-paper-dim)] leading-relaxed max-w-xs border-l border-[var(--color-border-deep)] pl-3">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
