---
import zhData from '../content/zh/stats';
import enData from '../content/en/stats';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { items } = fm;
---
<section class="relative overflow-hidden border-y border-[var(--color-border-deep)] min-h-screen flex items-center">
  <div class="absolute inset-0 -z-10">
    <img src="/images/stats-bg.jpg" alt="" class="w-full h-full object-cover opacity-15" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)]/80 via-[var(--color-abyss-0)]/75 to-[var(--color-abyss-1)]"></div>
  </div>
  <div class="relative max-w-[1280px] mx-auto px-6 py-20 w-full">
    <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-16 text-center">
      /00 · {lang === 'zh' ? '硬指标' : 'Numbers in production'}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8">
      {items.map((s: { value: string; suffix: string; label: string }, i: number) => (
        <div class="text-center md:text-left md:border-l md:border-[var(--color-border-deep)] md:pl-10 first:md:border-l-0 first:md:pl-0 relative">
          <div class="font-mono absolute -top-8 left-1/2 -translate-x-1/2 md:left-0 md:translate-x-0 text-[10px] uppercase eyebrow-tracking text-[var(--color-paper-dim)]/60">
            /0{i + 1}
          </div>
          <div class="font-mono text-7xl md:text-8xl lg:text-9xl text-[var(--color-lumen)] font-bold leading-none mb-5 tracking-tight">
            {s.value}<span class="text-4xl md:text-5xl ml-1 text-[var(--color-lumen)]/80">{s.suffix}</span>
          </div>
          <div class="font-mono text-[11px] uppercase eyebrow-tracking text-[var(--color-paper-dim)] leading-relaxed max-w-xs mx-auto md:mx-0">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
