---
import zhData from '../content/zh/demo';
import enData from '../content/en/demo';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const strip = (s: string) => s.replace(/[.。]+$/u, '');
---
<section id="demo" class="os-section os-section--dark" style="min-height: 80vh; display: flex; align-items: center;">
  <div class="os-container w-full">
    <div class="os-kicker">/04 · {fm.eyebrow}</div>
    <h2 class="os-h2 mt-4 mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem); max-width: 20ch;">
      {strip(fm.title)}
    </h2>
    <p class="mb-8 max-w-xl" style="color: var(--color-text-muted); font-size: 0.95rem;">{fm.subhead}</p>

    <figure class="os-frame" style="max-width: 960px;">
      <video src={fm.videoSrc} poster="/images/hero-impact.webp" muted loop autoplay playsinline class="aspect-video object-cover"></video>
      <figcaption>{lang === 'zh' ? 'BlueROV2 悬停训练' : 'BlueROV2 hover training'}</figcaption>
    </figure>
  </div>
</section>
