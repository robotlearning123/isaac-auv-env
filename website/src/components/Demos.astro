---
import zhData from '../content/zh/demo';
import enData from '../content/en/demo';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const cleanHeadline = (value: string) => value.replace(/[.。]+$/u, '');
---
<section id="demo" class="landing-section section-dark">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-kicker">/04 · {fm.eyebrow}</p>
      <h2 class="section-title">{cleanHeadline(fm.title)}</h2>
      <p class="section-copy">{fm.subhead}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="space-y-4">
        <div class="media-frame demo-video">
          <video
            src={fm.videoSrc}
            poster="/images/hero-impact-alt.webp"
            muted
            loop
            autoplay
            playsinline
            preload="metadata"
            class="h-full w-full object-cover"
            aria-label={lang === 'zh' ? 'BlueROV2 悬停演示' : 'BlueROV2 hover demo'}
          ></video>
        </div>
        <figure class="media-frame demo-map">
          <img
            src="/images/hero-bg.webp"
            alt={lang === 'zh' ? '海底地形等高线图' : 'Bathymetric contour map'}
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <figcaption>{lang === 'zh' ? '可复现实验场景' : 'Reproducible test scene'}</figcaption>
        </figure>
      </div>

      <div class="space-y-4">
        <div class="terminal-panel">
          <div class="terminal-panel__bar">
            <span></span>
            <span></span>
            <span></span>
            <strong>{fm.installLabel}</strong>
          </div>
          <pre><code><span class="terminal-prompt">$</span> {fm.installCommand}</code></pre>
        </div>

        <div class="table-shell compact mobile-scroll-hint">
          <table>
            <thead>
              <tr>
                {fm.benchHeaders.map((header: string) => (
                  <th>{header}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {fm.benchRows.map((row: string[], rowIndex: number) => (
                <tr class={rowIndex === fm.benchRows.length - 1 ? 'highlight-row' : ''}>
                  {row.map((cell: string) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="evidence-card">
          <p>{fm.benchNote}</p>
          {fm.caveat && <p>{fm.caveat}</p>}
        </div>

        <a href={fm.colabUrl} target="_blank" rel="noopener" class="btn-lumen">
          {fm.colabLabel}
        </a>
      </div>
    </div>
  </div>
</section>
