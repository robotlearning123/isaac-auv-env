---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      label: 'System',
      titleLines: ['Virtual Ocean'],
      body: 'OceanScale 把虚拟海洋、机器人策略、并行训练和可复现基准放进同一个工作流，让团队先在仿真中训练，再带着证据进入海洋。',
      pillars: [
        {
          label: 'Solution',
          title: '先在虚拟海洋中训练',
          body: '海流、地形、传感器、执行器和任务约束在 GPU 原生仿真环境中运行。',
        },
        {
          label: 'Product',
          title: '连接海洋物理与机器人策略',
          body: '水动力、推进器、传感器闭环、任务 API 和并行 rollout 组成训练基础设施。',
        },
        {
          label: 'Benchmarks',
          title: '把训练结果变成可复现证据',
          body: '策略在任务、扰动、失败边界和报告里重复验证，形成可比较的工程证据。',
        },
      ],
      panelLabel: 'OceanScale 训练系统面板',
    }
  : {
      label: 'System',
      titleLines: ['Virtual Ocean'],
      body: 'OceanScale puts the virtual ocean, robot policies, parallel training, and repeatable benchmarks into one workflow, so teams train in simulation before entering the ocean with evidence.',
      pillars: [
        {
          label: 'Solution',
          title: 'Train first in a virtual ocean',
          body: 'Currents, terrain, sensors, actuators, and task constraints run inside one GPU-native simulator.',
        },
        {
          label: 'Product',
          title: 'Connect ocean physics to robot policy',
          body: 'Hydrodynamics, thrusters, sensor loops, task APIs, and parallel rollouts form one training infrastructure.',
        },
        {
          label: 'Benchmarks',
          title: 'Turn training into repeatable evidence',
          body: 'Policies can be re-tested across tasks, disturbances, failure boundaries, and reports for comparable engineering proof.',
        },
      ],
      panelLabel: 'OceanScale training system panel',
    };

const panelRows = [
  ['hydrodynamics', 'stable'],
  ['sonar + camera', 'streaming'],
  ['reward shaping', 'active'],
  ['failure replay', 'recording'],
];
---

<section id="solution" class="system-session">
  <video
    class="system-session__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="system-session__shade"></div>

  <div class="os-container system-session__inner">
    <div class="system-session__head reveal">
      <div>
        <p class="section-label">{copy.label}</p>
        <h2>
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p>{copy.body}</p>
    </div>

    <div class="system-session__grid">
      <div class="system-session__pillars">
        {copy.pillars.map((pillar, index) => (
          <article
            id={pillar.label === 'Product' ? 'product' : pillar.label === 'Benchmarks' ? 'benchmarks' : undefined}
            class="system-pillar reveal"
            data-delay={String(index + 1)}
          >
            <span>{pillar.label}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))}
      </div>

      <figure class="system-session__panel reveal" data-delay="2">
        <div class="training-panel" aria-label={copy.panelLabel}>
          <div class="training-panel__top">
            <span>OceanScale Runtime</span>
            <strong>4096 envs</strong>
          </div>
          <div class="training-panel__map">
            {Array.from({ length: 42 }).map((_, index) => (
              <i style={`--delay:${index * 0.045}s; --alpha:${0.16 + ((index * 17) % 42) / 100};`}></i>
            ))}
          </div>
          <div class="training-panel__rows">
            {panelRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style is:global>
  .system-session {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: clamp(4.5rem, 6vw, 5.6rem) 0;
    display: flex;
    align-items: center;
    background: #060b12;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .system-session__media,
  .system-session__shade {
    position: absolute;
    inset: 0;
  }

  .system-session__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.78;
  }

  .system-session__shade {
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.94) 0%, rgba(3, 7, 12, 0.7) 42%, rgba(3, 7, 12, 0.36) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .system-session__inner {
    position: relative;
    z-index: 1;
  }

  .system-session__head {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 0.74fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }

  .system-session__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.7vw, 3.95rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.48);
  }

  html[lang="zh"] .system-session__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .system-session__head h2 span {
    display: block;
  }

  .system-session__head > p {
    margin: 0 0 0.35rem;
    max-width: 560px;
    color: rgba(232, 237, 243, 0.78);
    font-size: 1.05rem;
    line-height: 1.66;
  }

  .system-session__grid {
    display: grid;
    grid-template-columns: minmax(360px, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.1rem, 3vw, 2.25rem);
    align-items: start;
    margin-top: clamp(1.45rem, 3vw, 2.25rem);
  }

  .system-session__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    align-content: start;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.12);
  }

  .system-pillar {
    min-height: 118px;
    padding: clamp(0.85rem, 1.55vw, 1.08rem);
    background: rgba(3, 7, 12, 0.72);
    backdrop-filter: blur(14px);
    scroll-margin-top: 96px;
  }

  .system-pillar span {
    display: block;
    color: rgba(45, 212, 191, 0.94);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .system-pillar h3 {
    margin: 0.52rem 0 0;
    color: #fff;
    font-size: 1.02rem;
    font-weight: 850;
    line-height: 1.22;
  }

  .system-pillar p {
    margin: 0.42rem 0 0;
    color: rgba(232, 237, 243, 0.68);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .system-session__panel {
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(6, 11, 18, 0.64);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(14px);
  }

  .training-panel {
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1rem, 2vw, 1.4rem);
    background:
      radial-gradient(circle at 68% 22%, rgba(45, 212, 191, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(5, 10, 16, 0.96), rgba(9, 18, 28, 0.94));
  }

  .training-panel__top,
  .training-panel__rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .training-panel__top {
    min-height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(232, 237, 243, 0.62);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .training-panel__top strong {
    color: rgba(45, 212, 191, 0.96);
  }

  .training-panel__map {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 0.55rem;
    align-content: center;
    min-height: 205px;
    padding: clamp(0.9rem, 1.6vw, 1.35rem) 0;
  }

  .training-panel__map i {
    display: block;
    aspect-ratio: 1;
    border: 1px solid rgba(45, 212, 191, 0.4);
    border-radius: 4px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.22), transparent 18%),
      linear-gradient(135deg, rgba(45, 212, 191, calc(var(--alpha) + 0.22)), rgba(45, 212, 191, 0.04));
    box-shadow:
      inset 0 0 18px rgba(45, 212, 191, 0.2),
      0 0 18px rgba(45, 212, 191, 0.08);
    animation: training-cell 1.4s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  .training-panel__rows {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .training-panel__rows div {
    padding: 0.65rem 0.85rem;
    background: rgba(3, 7, 12, 0.66);
  }

  .training-panel__rows span {
    color: rgba(232, 237, 243, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .training-panel__rows strong {
    color: rgba(232, 237, 243, 0.92);
    font-size: 0.76rem;
  }

  @keyframes training-cell {
    0% { opacity: 0.45; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(-2px); }
  }

  @media (max-width: 980px) {
    .system-session {
      display: block;
      min-height: auto;
      padding: clamp(4.5rem, 12vw, 6rem) 0;
    }

    .system-session__media {
      height: 44vh;
      min-height: 260px;
      object-position: center top;
      mask-image: linear-gradient(180deg, black 0%, transparent 100%);
    }

    .system-session__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0.16) 0%, var(--color-bg) 42%, var(--color-bg) 100%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .system-session__head,
    .system-session__grid {
      grid-template-columns: 1fr;
    }

    .system-session__head {
      gap: 1.05rem;
      padding-top: 33vh;
    }

    .system-session__head h2 {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .system-session__head > p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .system-pillar {
      min-height: auto;
    }

    .training-panel {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .training-panel__rows {
      display: none;
    }

    .training-panel__map {
      min-height: 0;
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

  }
</style>
