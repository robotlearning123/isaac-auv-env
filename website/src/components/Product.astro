---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      label: '解决方案',
      titleLines: ['虚拟海洋'],
      body: 'OceanScale 把水动力学、海洋环境、传感器、机器人接口和训练评估管线放进同一个 GPU 原生运行时，围绕真实海洋环境完成大规模训练、测试、失败回放与验证。',
      inputLabel: '输入',
      coreLabel: 'GPU 原生运行时',
      outputLabel: '输出',
      coreTitle: 'Virtual Ocean Runtime',
      inputs: [
        ['机器人模型', 'AUV / ROV / 滑翔机 / 机械臂'],
        ['真实海况', '洋流、能见度、地形、扰动'],
        ['任务目标', '对接、保持、巡检、搜寻'],
      ],
      layers: [
        ['物理内核', '六自由度动力学、浮力、阻力、推进器响应'],
        ['海洋环境', '海流场、浑浊度、地形、传感器退化'],
        ['机器人接口', '控制策略、任务 API、批量环境'],
        ['评估管线', '轨迹日志、失败回放、版本对比'],
      ],
      outputs: [
        ['并行实验', '成千上万组可复现任务'],
        ['失败复盘', '把真实任务条件带回仿真'],
        ['验证指标', '收敛、稳定性、鲁棒性和风险边界'],
      ],
    }
  : {
      label: 'Solution',
      titleLines: ['Virtual Ocean'],
      body: 'OceanScale brings hydrodynamics, ocean environments, sensors, robot interfaces, and training/evaluation pipelines into one GPU-native runtime for large-scale training, testing, failure replay, and real-ocean validation.',
      inputLabel: 'Inputs',
      coreLabel: 'GPU-native runtime',
      outputLabel: 'Outputs',
      coreTitle: 'Virtual Ocean Runtime',
      inputs: [
        ['Robot Models', 'AUVs / ROVs / gliders / manipulators'],
        ['Ocean Conditions', 'Current, visibility, terrain, disturbance'],
        ['Mission Goals', 'Docking, holding, inspection, search'],
      ],
      layers: [
        ['Physics Core', '6-DoF dynamics, buoyancy, drag, thruster response'],
        ['Ocean Field', 'Currents, turbidity, terrain, sensor degradation'],
        ['Robot Interface', 'Control policies, task APIs, batched environments'],
        ['Evaluation Pipeline', 'Trajectory logs, failure replay, version comparison'],
      ],
      outputs: [
        ['Parallel Experiments', 'Thousands of reproducible mission runs'],
        ['Failure Replay', 'Bring real mission conditions back into simulation'],
        ['Validation Metrics', 'Convergence, stability, robustness, risk boundary'],
      ],
    };
---

<section id="solution" class="system-session">
  <video
    class="system-session__media"
    data-background-video
    aria-hidden="true"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="system-session__shade"></div>

  <div class="os-container system-session__inner">
    <div class="system-session__head reveal">
      <div>
        <p class="section-label">{copy.label}</p>
        <h2>
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p>{copy.body}</p>
    </div>

    <div class="system-session__grid reveal" data-delay="1">
      <div class="runtime-figure">
        <div class="runtime-stream runtime-stream--input">
          <p>{copy.inputLabel}</p>
          {copy.inputs.map(([title, body]) => (
            <div class="runtime-node">
              <strong>{title}</strong>
              <span>{body}</span>
            </div>
          ))}
        </div>

        <div class="runtime-orbit">
          <div class="runtime-orbit__ring runtime-orbit__ring--outer" aria-hidden="true"></div>
          <div class="runtime-orbit__ring runtime-orbit__ring--inner" aria-hidden="true"></div>
          <div class="runtime-orbit__content">
            <span>{copy.coreLabel}</span>
            <strong>{copy.coreTitle}</strong>
            <div class="runtime-layer-list">
              {copy.layers.map(([title, body]) => (
                <div>
                  <strong>{title}</strong>
                  <span>{body}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="runtime-stream runtime-stream--output">
          <p>{copy.outputLabel}</p>
          {copy.outputs.map(([title, body]) => (
            <div class="runtime-node">
              <strong>{title}</strong>
              <span>{body}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .system-session {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: clamp(4.5rem, 6vw, 5.6rem) 0;
    display: flex;
    align-items: center;
    background: #060b12;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .system-session__media,
  .system-session__shade {
    position: absolute;
    inset: 0;
  }

  .system-session__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.78;
  }

  .system-session__shade {
    background:
      linear-gradient(110deg, rgba(4, 16, 33, 0.94) 0%, rgba(4, 10, 22, 0.66) 42%, rgba(8, 16, 28, 0.34) 100%),
      radial-gradient(circle at 26% 24%, rgba(45, 212, 191, 0.14), transparent 40%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .system-session__inner {
    position: relative;
    z-index: 1;
  }

  .system-session__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.82fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .system-session__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.7vw, 3.95rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.48);
  }

  html[lang="zh"] .system-session__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .system-session__head h2 span {
    display: block;
  }

  .system-session__head > p {
    margin: 0;
    max-width: 620px;
    color: rgba(232, 237, 243, 0.78);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.72;
  }

  .system-session__grid {
    display: block;
    width: min(100%, 1120px);
    margin-top: clamp(1.7rem, 4vw, 3.4rem);
  }

  .runtime-figure {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.78fr) minmax(390px, 1.55fr) minmax(210px, 0.9fr);
    gap: clamp(1rem, 2vw, 1.35rem);
    align-items: center;
    max-width: 1120px;
    min-height: 23rem;
    padding: clamp(1rem, 1.8vw, 1.35rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      linear-gradient(135deg, rgba(3, 7, 12, 0.82), rgba(3, 7, 12, 0.48)),
      radial-gradient(circle at 50% 40%, rgba(45, 212, 191, 0.16), transparent 52%);
    backdrop-filter: blur(14px);
  }

  .runtime-stream {
    position: relative;
    display: grid;
    grid-template-rows: auto repeat(3, 1fr);
    gap: 0.7rem;
    min-width: 0;
    z-index: 2;
  }

  .runtime-stream--input::after,
  .runtime-stream--output::before {
    content: "";
    position: absolute;
    top: 52%;
    width: clamp(1.2rem, 2.4vw, 2.1rem);
    height: 1px;
    background: linear-gradient(90deg, rgba(45, 212, 191, 0), rgba(45, 212, 191, 0.82));
  }

  .runtime-stream--input::after {
    right: calc(clamp(1rem, 2vw, 1.35rem) * -1);
  }

  .runtime-stream--output::before {
    left: calc(clamp(1rem, 2vw, 1.35rem) * -1);
    transform: rotate(180deg);
  }

  .runtime-stream > p,
  .runtime-orbit__content > span {
    margin: 0;
    color: rgba(45, 212, 191, 0.95);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .runtime-node {
    border: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(3, 7, 12, 0.68);
    display: grid;
    align-content: center;
    min-height: 5.2rem;
    padding: 0.78rem 0.85rem;
    backdrop-filter: blur(10px);
  }

  .runtime-node strong,
  .runtime-layer-list strong {
    color: #fff;
    font-size: 0.92rem;
    line-height: 1.18;
  }

  .runtime-node span,
  .runtime-layer-list span {
    display: block;
    margin-top: 0.42rem;
    color: rgba(232, 237, 243, 0.62);
    font-size: 0.76rem;
    line-height: 1.42;
  }

  .runtime-orbit {
    position: relative;
    min-width: 0;
    min-height: 20rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(45, 212, 191, 0.22);
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 48%, rgba(45, 212, 191, 0.24), transparent 28%),
      radial-gradient(circle at 50% 48%, rgba(45, 212, 191, 0.1), transparent 56%),
      linear-gradient(135deg, rgba(4, 23, 28, 0.84), rgba(3, 7, 12, 0.72));
    box-shadow:
      inset 0 0 0 1px rgba(45, 212, 191, 0.12),
      inset 0 0 80px rgba(45, 212, 191, 0.08),
      0 30px 80px rgba(0, 0, 0, 0.26);
  }

  .runtime-orbit::before {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 145%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(45, 212, 191, 0.58), transparent);
    transform: translate(-50%, -50%) rotate(-13deg);
    opacity: 0.82;
  }

  .runtime-orbit__ring {
    position: absolute;
    border: 1px solid rgba(45, 212, 191, 0.18);
    border-radius: 50%;
    pointer-events: none;
  }

  .runtime-orbit__ring--outer {
    inset: 8%;
  }

  .runtime-orbit__ring--inner {
    inset: 23%;
    border-color: rgba(255, 255, 255, 0.13);
  }

  .runtime-orbit__content {
    position: relative;
    z-index: 1;
    width: min(82%, 25rem);
    padding: clamp(1.05rem, 2vw, 1.4rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(3, 7, 12, 0.72);
    backdrop-filter: blur(14px);
  }

  .runtime-orbit__content > strong {
    display: block;
    margin-top: 0.7rem;
    color: #fff;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    letter-spacing: 0.02em;
  }

  .runtime-layer-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.62rem;
    margin-top: 1.05rem;
  }

  .runtime-layer-list div {
    min-height: 5.15rem;
    padding: 0.78rem;
    border-left: 1px solid rgba(45, 212, 191, 0.52);
    background: rgba(3, 7, 12, 0.48);
  }

  @media (max-width: 980px) {
    .system-session {
      display: block;
      min-height: auto;
      padding: clamp(4.5rem, 12vw, 6rem) 0;
    }

    .system-session__media {
      height: 44vh;
      min-height: 260px;
      object-position: center top;
      mask-image: linear-gradient(180deg, black 0%, transparent 100%);
    }

    .system-session__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0.16) 0%, var(--color-bg) 42%, var(--color-bg) 100%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .system-session__head,
    .system-session__grid {
      grid-template-columns: 1fr;
    }

    .system-session__head {
      gap: 1.05rem;
      padding-top: 33vh;
    }

    .system-session__head h2 {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .system-session__head > p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .runtime-figure {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 0.9rem;
      background: rgba(3, 7, 12, 0.62);
      min-height: 0;
    }

    .runtime-stream--input::after,
    .runtime-stream--output::before {
      display: none;
    }

    .runtime-stream {
      grid-template-rows: auto;
    }

    .runtime-orbit {
      min-height: 0;
      border-radius: 0;
      padding: 0;
    }

    .runtime-orbit__content {
      width: 100%;
    }

    .runtime-layer-list {
      grid-template-columns: 1fr;
    }

    .runtime-node,
    .runtime-layer-list div {
      min-height: 0;
    }

  }
</style>
