---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const heading = isZh
  ? '一套训练系统，贯通海洋物理与机器人策略。'
  : 'One system for ocean physics and robot policy.';
const headingLines = isZh
  ? ['一套训练系统，', '贯通海洋物理', '与机器人策略。']
  : null;

const body = isZh
  ? '不是单个演示场景，而是面向水下机器人研发的仿真基础设施：物理、传感器、任务、并行 rollout 和验证基准一起运行。'
  : 'Not a one-off demo scene, but simulation infrastructure for underwater robotics: physics, sensors, tasks, parallel rollouts, and validation benchmarks running together.';

const cards = isZh ? [
  { title: 'GPU 原生仿真', body: '水动力、浮力、接触、推进器和执行器统一在并行环境中求解。' },
  { title: '传感器闭环', body: '相机、声纳、DVL、IMU 和压力传感器可用于策略训练与验证。' },
  { title: '训练吞吐', body: '用数千个场景同时生成经验，而不是等待下一次海试窗口。' },
  { title: '标准接口', body: '面向 Gymnasium 和常见 RL 工作流，方便研究与工程团队接入。' },
] : [
  { title: 'GPU-native simulation', body: 'Hydrodynamics, buoyancy, contact, thrusters, and actuators solved across parallel environments.' },
  { title: 'Sensor-in-the-loop', body: 'Camera, sonar, DVL, IMU, and pressure signals for policy training and validation.' },
  { title: 'Training throughput', body: 'Generate experience from thousands of scenarios instead of waiting for the next sea-trial window.' },
  { title: 'Standard interfaces', body: 'Designed around Gymnasium and common RL workflows for research and engineering teams.' },
];
---
<section id="product" class="product-system">
  <div class="os-container product-system__inner">
    <div class="product-system__copy reveal">
      <p class="section-label">Product</p>
      <h2>
        {headingLines
          ? headingLines.map((line) => <span>{line}</span>)
          : heading}
      </h2>
      <p>{body}</p>
    </div>

    <div class="product-system__grid">
      <figure class="product-system__media reveal" data-delay="1">
        <div class="training-panel" aria-label={isZh ? 'OceanScale 训练系统面板' : 'OceanScale training system panel'}>
          <div class="training-panel__top">
            <span>OceanScale Runtime</span>
            <strong>4096 envs</strong>
          </div>
          <div class="training-panel__map">
            {Array.from({ length: 42 }).map((_, index) => (
              <i style={`--delay:${index * 0.045}s; --alpha:${0.16 + ((index * 17) % 42) / 100};`}></i>
            ))}
          </div>
          <div class="training-panel__rows">
            {[
              ['hydrodynamics', 'stable'],
              ['sonar + camera', 'streaming'],
              ['reward shaping', 'active'],
              ['failure replay', 'recording'],
            ].map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </div>
      </figure>

      <div class="product-system__cards">
        {cards.map((card, index) => (
          <article class="product-system__card reveal" data-delay={String(index + 2)}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .product-system {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(circle at 78% 18%, rgba(45, 212, 191, 0.1), transparent 28rem),
      linear-gradient(180deg, #060b12 0%, #08111a 52%, #060b12 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .product-system::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(45, 212, 191, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 212, 191, 0.08) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 0%, transparent 70%);
  }

  .product-system__inner {
    position: relative;
    z-index: 1;
  }

  .product-system__copy {
    max-width: 860px;
  }

  .product-system__copy h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 3.8rem;
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  html[lang="zh"] .product-system__copy h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .product-system__copy h2 span {
    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }

  .product-system__copy > p:last-child {
    margin: 1.35rem 0 0;
    max-width: 700px;
    color: rgba(232, 237, 243, 0.74);
    font-size: 1.08rem;
    line-height: 1.66;
  }

  .product-system__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(320px, 0.84fr);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: stretch;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .product-system__media,
  .product-system__card {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(6, 11, 18, 0.62);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(14px);
  }

  .product-system__media {
    overflow: hidden;
    margin: 0;
    min-height: 100%;
    border-radius: 8px;
  }

  .training-panel {
    min-height: 520px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1rem, 2vw, 1.4rem);
    background:
      radial-gradient(circle at 68% 22%, rgba(45, 212, 191, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(5, 10, 16, 0.96), rgba(9, 18, 28, 0.94));
  }

  .training-panel__top,
  .training-panel__rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .training-panel__top {
    min-height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(232, 237, 243, 0.62);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .training-panel__top strong {
    color: rgba(45, 212, 191, 0.96);
  }

  .training-panel__map {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.55rem;
    align-content: center;
    min-height: 320px;
    padding: clamp(1.3rem, 3vw, 2.2rem) 0;
  }

  .training-panel__map i {
    display: block;
    aspect-ratio: 1;
    border: 1px solid rgba(45, 212, 191, 0.4);
    border-radius: 4px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.22), transparent 18%),
      linear-gradient(135deg, rgba(45, 212, 191, calc(var(--alpha) + 0.22)), rgba(45, 212, 191, 0.04));
    box-shadow:
      inset 0 0 18px rgba(45, 212, 191, 0.2),
      0 0 18px rgba(45, 212, 191, 0.08);
    animation: training-cell 1.4s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  .training-panel__rows {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .training-panel__rows div {
    padding: 0.85rem 1rem;
    background: rgba(3, 7, 12, 0.66);
  }

  .training-panel__rows span {
    color: rgba(232, 237, 243, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .training-panel__rows strong {
    color: rgba(232, 237, 243, 0.92);
    font-size: 0.76rem;
  }

  @keyframes training-cell {
    0% { opacity: 0.45; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(-2px); }
  }

  .product-system__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .product-system__card {
    padding: clamp(1.1rem, 2vw, 1.45rem);
    border-radius: 8px;
  }

  .product-system__card span {
    display: block;
    color: rgba(45, 212, 191, 0.94);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .product-system__card h3 {
    margin: 0.7rem 0 0;
    color: #fff;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .product-system__card p {
    margin: 0.5rem 0 0;
    color: rgba(232, 237, 243, 0.68);
    font-size: 0.92rem;
    line-height: 1.58;
  }

  @media (max-width: 900px) {
    .product-system__copy h2 {
      font-size: 2.35rem;
      line-height: 1.08;
    }

    .product-system__copy > p:last-child {
      font-size: 1rem;
      line-height: 1.6;
    }

    .product-system__grid {
      grid-template-columns: 1fr;
    }

    .training-panel {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .training-panel__rows {
      display: none;
    }

    .training-panel__map {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }

  @media (min-width: 1440px) {
    .product-system__copy h2 {
      font-size: 4.2rem;
    }
  }
</style>
