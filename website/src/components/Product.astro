---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      label: 'Solution',
      titleLines: ['Virtual Ocean'],
      body: '一个可控、并行、可回放的海洋仿真环境，让水下机器人在部署前经历任务、失败与恢复。',
      briefTitle: '训练闭环',
      briefBody: '把最昂贵的海试前迭代放进仿真：大规模训练、失败重放、部署前验证。',
      coreStages: ['任务', '失败', '恢复'],
      coreLine: '在真实海试前，先跑完可回放的虚拟任务。',
      panelLabel: 'OceanScale 训练系统面板',
    }
  : {
      label: 'Solution',
      titleLines: ['Virtual Ocean'],
      body: 'A controllable, parallel, replayable ocean simulator where underwater robots experience missions, failures, and recovery before deployment.',
      briefTitle: 'Training loop',
      briefBody: 'Move the most expensive pre-sea-trial iteration into simulation: large-scale training, failure replay, and deployment validation.',
      coreStages: ['Mission', 'Failure', 'Recovery'],
      coreLine: 'Before sea trials, run the mission in a replayable virtual ocean.',
      panelLabel: 'OceanScale training system panel',
    };

const panelRows = [
  ['parallel rollouts', 'active'],
  ['failure replay', 'live'],
  ['deployment gate', 'ready'],
];
---

<section id="solution" class="system-session">
  <video
    class="system-session__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="system-session__shade"></div>

  <div class="os-container system-session__inner">
    <div class="system-session__head reveal">
      <div>
        <p class="section-label">{copy.label}</p>
        <h2>
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p>{copy.body}</p>
    </div>

    <div class="system-session__grid">
      <div class="solution-brief reveal" data-delay="1">
        <h3>{copy.briefTitle}</h3>
        <p>{copy.briefBody}</p>
      </div>

      <figure class="system-session__panel reveal" data-delay="2">
        <div class="training-panel" aria-label={copy.panelLabel}>
          <div class="training-panel__top">
            <span>OceanScale Runtime</span>
            <strong>4096 envs</strong>
          </div>
          <div class="training-panel__core">
            <div class="training-panel__loop" aria-hidden="true">
              <span class="training-panel__orbit training-panel__orbit--outer"></span>
              <span class="training-panel__orbit training-panel__orbit--inner"></span>
              <span class="training-panel__route"></span>
              <span class="training-panel__vehicle"></span>
            </div>
            <div class="training-panel__core-copy">
              <span>Virtual Ocean</span>
              <div class="training-panel__stages">
                {copy.coreStages.map((stage) => (
                  <strong>{stage}</strong>
                ))}
              </div>
              <p>{copy.coreLine}</p>
            </div>
          </div>
          <div class="training-panel__rows">
            {panelRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style is:global>
  .system-session {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: clamp(4.5rem, 6vw, 5.6rem) 0;
    display: flex;
    align-items: center;
    background: #060b12;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .system-session__media,
  .system-session__shade {
    position: absolute;
    inset: 0;
  }

  .system-session__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.78;
  }

  .system-session__shade {
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.94) 0%, rgba(3, 7, 12, 0.7) 42%, rgba(3, 7, 12, 0.36) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .system-session__inner {
    position: relative;
    z-index: 1;
  }

  .system-session__head {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 0.74fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }

  .system-session__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.7vw, 3.95rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.48);
  }

  html[lang="zh"] .system-session__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .system-session__head h2 span {
    display: block;
  }

  .system-session__head > p {
    margin: 0 0 0.35rem;
    max-width: 560px;
    color: rgba(232, 237, 243, 0.78);
    font-size: 1.05rem;
    line-height: 1.66;
  }

  .system-session__grid {
    display: grid;
    grid-template-columns: minmax(360px, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.1rem, 3vw, 2.25rem);
    align-items: start;
    margin-top: clamp(1.45rem, 3vw, 2.25rem);
  }

  .solution-brief {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(1.05rem, 1.8vw, 1.4rem);
    background: rgba(3, 7, 12, 0.72);
    backdrop-filter: blur(14px);
  }

  .solution-brief h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.25rem, 2.1vw, 1.72rem);
    font-weight: 850;
    line-height: 1.12;
  }

  .solution-brief > p {
    margin: 0.9rem 0 0;
    color: rgba(232, 237, 243, 0.68);
    font-size: 1rem;
    line-height: 1.68;
  }

  .system-session__panel {
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(6, 11, 18, 0.64);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(14px);
  }

  .training-panel {
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1rem, 2vw, 1.4rem);
    background:
      radial-gradient(circle at 68% 22%, rgba(45, 212, 191, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(5, 10, 16, 0.96), rgba(9, 18, 28, 0.94));
  }

  .training-panel__top,
  .training-panel__rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .training-panel__top {
    min-height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(232, 237, 243, 0.62);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .training-panel__top strong {
    color: rgba(45, 212, 191, 0.96);
  }

  .training-panel__core {
    display: grid;
    grid-template-columns: minmax(160px, 0.74fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.65rem);
    align-items: center;
    min-height: 205px;
    padding: clamp(0.9rem, 1.7vw, 1.45rem) 0;
  }

  .training-panel__loop {
    position: relative;
    display: block;
    aspect-ratio: 1;
    width: min(100%, 190px);
    margin-inline: auto;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 50%, rgba(45, 212, 191, 0.18), rgba(45, 212, 191, 0.04) 42%, transparent 68%);
    box-shadow:
      inset 0 0 40px rgba(45, 212, 191, 0.08),
      0 0 48px rgba(45, 212, 191, 0.08);
  }

  .training-panel__orbit,
  .training-panel__route,
  .training-panel__vehicle {
    position: absolute;
    display: block;
  }

  .training-panel__orbit {
    inset: 9%;
    border: 1px solid rgba(45, 212, 191, 0.36);
    border-radius: 999px;
  }

  .training-panel__orbit--inner {
    inset: 28%;
    border-color: rgba(232, 237, 243, 0.16);
  }

  .training-panel__route {
    top: 50%;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(45, 212, 191, 0.8), transparent);
    transform: rotate(-18deg);
  }

  .training-panel__vehicle {
    top: 36%;
    left: 49%;
    width: 18%;
    aspect-ratio: 1.8;
    border: 1px solid rgba(232, 237, 243, 0.4);
    border-radius: 999px 999px 55% 55%;
    background: linear-gradient(135deg, rgba(232, 237, 243, 0.42), rgba(45, 212, 191, 0.14));
    box-shadow: 0 0 24px rgba(45, 212, 191, 0.2);
    animation: training-orbit 3.6s ease-in-out infinite alternate;
  }

  .training-panel__core-copy span {
    display: block;
  }

  .training-panel__core-copy span {
    color: rgba(45, 212, 191, 0.92);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .training-panel__stages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.52rem 0.7rem;
    margin-top: 0.55rem;
  }

  .training-panel__stages strong {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    font-weight: 850;
    line-height: 1.1;
  }

  .training-panel__stages strong:not(:last-child)::after {
    content: "";
    width: clamp(1rem, 2vw, 1.7rem);
    height: 1px;
    background: linear-gradient(90deg, rgba(45, 212, 191, 0.85), rgba(45, 212, 191, 0));
  }

  .training-panel__core-copy p {
    margin: 0.75rem 0 0;
    color: rgba(232, 237, 243, 0.66);
    font-size: 0.92rem;
    line-height: 1.56;
  }

  .training-panel__rows {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .training-panel__rows div {
    padding: 0.65rem 0.85rem;
    background: rgba(3, 7, 12, 0.66);
  }

  .training-panel__rows span {
    color: rgba(232, 237, 243, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .training-panel__rows strong {
    color: rgba(232, 237, 243, 0.92);
    font-size: 0.76rem;
  }

  @keyframes training-orbit {
    0% { transform: translate(-18%, 14%) rotate(-10deg); opacity: 0.68; }
    100% { transform: translate(18%, -12%) rotate(8deg); opacity: 1; }
  }

  @media (max-width: 980px) {
    .system-session {
      display: block;
      min-height: auto;
      padding: clamp(4.5rem, 12vw, 6rem) 0;
    }

    .system-session__media {
      height: 44vh;
      min-height: 260px;
      object-position: center top;
      mask-image: linear-gradient(180deg, black 0%, transparent 100%);
    }

    .system-session__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0.16) 0%, var(--color-bg) 42%, var(--color-bg) 100%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .system-session__head,
    .system-session__grid {
      grid-template-columns: 1fr;
    }

    .system-session__head {
      gap: 1.05rem;
      padding-top: 33vh;
    }

    .system-session__head h2 {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .system-session__head > p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .training-panel {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .training-panel__rows {
      display: none;
    }

    .training-panel__core {
      height: 100%;
      min-height: 0;
      grid-template-columns: minmax(88px, 0.62fr) minmax(0, 1fr);
      gap: 0.9rem;
    }

    .training-panel__loop {
      width: min(100%, 120px);
    }

    .training-panel__stages {
      gap: 0.38rem 0.52rem;
    }

    .training-panel__stages strong {
      font-size: 1.18rem;
    }

    .training-panel__core-copy p {
      display: none;
    }

  }
</style>
