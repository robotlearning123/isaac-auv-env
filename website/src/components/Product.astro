---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      label: '解决方案',
      titleLines: ['海试前的仿真基础设施'],
      body: 'OceanScale 面向水下机器人构建仿真技术栈：物理内核、海洋环境、机器人接口、任务生成和训练评估在同一个可扩展运行时中协同工作。',
      briefTitle: '技术栈细节',
      briefBody: '从底层物理到上层训练评估，每一层都围绕水下机器人海试前验证设计。',
      flow: [
        ['内核', 'GPU 物理内核', '六自由度动力学、浮力/阻力、推进器响应、接触碰撞和机械臂载荷。'],
        ['世界', '海洋与传感器', '海流场、能见度、海底地形、声呐/相机噪声、定位漂移和通信延迟。'],
        ['接口', '机器人与任务 API', 'AUV/ROV、推进器、机械臂、任务目标和约束统一接入。'],
        ['管线', '训练评估管线', '并行环境、策略采样、失败回放、轨迹日志、指标统计和门控报告。'],
      ],
    }
  : {
      label: 'Solution',
      titleLines: ['Simulation infrastructure before sea trials'],
      body: 'OceanScale builds a simulation stack for underwater robots: physics core, ocean worlds, robot interfaces, mission generation, training, and evaluation working together in one scalable runtime.',
      briefTitle: 'Tech stack details',
      briefBody: 'From low-level physics to training evaluation, every layer is designed for underwater robot validation before sea trials.',
      flow: [
        ['Core', 'GPU physics core', '6-DoF dynamics, buoyancy/drag, thruster response, contact, and manipulator payloads.'],
        ['World', 'Ocean and sensors', 'Current fields, visibility, seafloor terrain, sonar/camera noise, localization drift, and latency.'],
        ['API', 'Robot and mission API', 'Unified interfaces for AUVs/ROVs, thrusters, manipulators, objectives, and constraints.'],
        ['Pipeline', 'Training evaluation pipeline', 'Parallel environments, policy sampling, failure replay, trajectory logs, metrics, and gate reports.'],
      ],
    };
---

<section id="solution" class="system-session">
  <video
    class="system-session__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="system-session__shade"></div>

  <div class="os-container system-session__inner">
    <div class="system-session__head reveal">
      <div>
        <p class="section-label">{copy.label}</p>
        <h2>
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p>{copy.body}</p>
    </div>

    <div class="system-session__grid">
      <div class="solution-brief reveal" data-delay="1">
        <div class="solution-brief__intro">
          <h3>{copy.briefTitle}</h3>
          <p>{copy.briefBody}</p>
        </div>
        <div class="solution-flow">
          {copy.flow.map(([index, title, body]) => (
            <div class="solution-flow__item">
              <span>{index}</span>
              <strong>{title}</strong>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .system-session {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: clamp(4.5rem, 6vw, 5.6rem) 0;
    display: flex;
    align-items: center;
    background: #060b12;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .system-session__media,
  .system-session__shade {
    position: absolute;
    inset: 0;
  }

  .system-session__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.78;
  }

  .system-session__shade {
    background:
      linear-gradient(110deg, rgba(4, 16, 33, 0.94) 0%, rgba(4, 10, 22, 0.66) 42%, rgba(8, 16, 28, 0.34) 100%),
      radial-gradient(circle at 26% 24%, rgba(45, 212, 191, 0.14), transparent 40%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .system-session__inner {
    position: relative;
    z-index: 1;
  }

  .system-session__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.82fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .system-session__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.7vw, 3.95rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.48);
  }

  html[lang="zh"] .system-session__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .system-session__head h2 span {
    display: block;
  }

  .system-session__head > p {
    margin: 0;
    max-width: 620px;
    color: rgba(232, 237, 243, 0.78);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.72;
  }

  .system-session__grid {
    display: block;
    width: min(100%, 920px);
    margin-top: clamp(1.7rem, 4vw, 3.4rem);
  }

  .solution-brief {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    max-width: 920px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(45, 212, 191, 0.62);
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.78), rgba(3, 7, 12, 0.38)),
      radial-gradient(circle at 78% 18%, rgba(45, 212, 191, 0.12), transparent 36%);
    backdrop-filter: blur(14px);
  }

  .solution-brief h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.45rem, 2.35vw, 2.05rem);
    font-weight: 850;
    line-height: 1.12;
  }

  .solution-brief__intro {
    padding: clamp(1rem, 1.8vw, 1.35rem) clamp(1rem, 1.8vw, 1.35rem) clamp(0.9rem, 1.6vw, 1.15rem);
  }

  .solution-brief__intro > p {
    margin: 0.7rem 0 0;
    max-width: 600px;
    color: rgba(232, 237, 243, 0.72);
    font-size: 1rem;
    line-height: 1.64;
  }

  .solution-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .solution-flow__item {
    position: relative;
    display: grid;
    align-content: start;
    min-height: 11.4rem;
    padding: clamp(0.9rem, 1.45vw, 1.15rem);
    background: rgba(3, 7, 12, 0.68);
    backdrop-filter: blur(10px);
  }

  .solution-flow__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.38rem;
    right: 0.78rem;
    width: 1.35rem;
    height: 1px;
    background: rgba(45, 212, 191, 0.7);
  }

  .solution-flow__item span {
    color: rgba(45, 212, 191, 0.9);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .solution-flow__item strong {
    margin-top: 0.65rem;
    color: #fff;
    font-size: 1rem;
    line-height: 1.2;
  }

  .solution-flow__item p {
    margin: 0.65rem 0 0;
    color: rgba(232, 237, 243, 0.66);
    font-size: 0.84rem;
    line-height: 1.52;
  }

  @media (max-width: 980px) {
    .system-session {
      display: block;
      min-height: auto;
      padding: clamp(4.5rem, 12vw, 6rem) 0;
    }

    .system-session__media {
      height: 44vh;
      min-height: 260px;
      object-position: center top;
      mask-image: linear-gradient(180deg, black 0%, transparent 100%);
    }

    .system-session__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0.16) 0%, var(--color-bg) 42%, var(--color-bg) 100%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .system-session__head,
    .system-session__grid {
      grid-template-columns: 1fr;
    }

    .system-session__head {
      gap: 1.05rem;
      padding-top: 33vh;
    }

    .system-session__head h2 {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .system-session__head > p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .solution-brief {
      border-left: 0;
      background: rgba(3, 7, 12, 0.56);
    }

    .solution-flow {
      grid-template-columns: 1fr;
    }

    .solution-flow__item {
      min-height: 0;
    }

    .solution-flow__item:not(:last-child)::after {
      display: none;
    }

  }
</style>
