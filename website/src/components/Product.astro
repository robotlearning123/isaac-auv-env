---
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh';

const copy = isZh
  ? {
      label: 'Solution',
      titleLines: ['Virtual Ocean'],
      body: 'OceanScale 用一个可控的虚拟海洋替代反复下海试错，让水下机器人先在海流、地形、低能见度和任务失败中完成大规模训练。',
      briefTitle: '先训练 再下海',
      briefBody: '这不是把旧模块堆在一起，而是为水下机器人建立一个可重复、可加速、可回放的训练场。',
      rows: [
        {
          title: '海况变化',
          body: '海流、能见度、地形和传感器噪声持续变化，让策略先经历真实海试前的复杂性。',
        },
        {
          title: '机器人群训练',
          body: '多种水下机器人同时 rollout，快速暴露失败边界，而不是等待下一次船期。',
        },
        {
          title: '部署前回放',
          body: '每次策略更新都留下任务轨迹、失败片段和验证结果，方便团队判断是否值得下海。',
        },
      ],
      panelLabel: 'OceanScale 训练系统面板',
    }
  : {
      label: 'Solution',
      titleLines: ['Virtual Ocean'],
      body: 'OceanScale replaces repeated offshore trial-and-error with a controllable virtual ocean where underwater robots train through currents, terrain, low visibility, and mission failure at scale.',
      briefTitle: 'Train before sea trials',
      briefBody: 'This is not the old sections stacked together. It is a repeatable, accelerated, replayable training ocean for underwater robots.',
      rows: [
        {
          title: 'Ocean variation',
          body: 'Currents, visibility, terrain, and sensor noise keep changing so policies meet complexity before the field.',
        },
        {
          title: 'Fleet training',
          body: 'Multiple underwater robot forms roll out at the same time, exposing failure boundaries without waiting for another vessel window.',
        },
        {
          title: 'Pre-deployment replay',
          body: 'Every policy update leaves mission traces, failure clips, and validation results so teams know when a sea trial is worth it.',
        },
      ],
      panelLabel: 'OceanScale training system panel',
    };

const panelRows = [
  ['hydrodynamics', 'stable'],
  ['sonar + camera', 'streaming'],
  ['reward shaping', 'active'],
  ['failure replay', 'recording'],
];
---

<section id="solution" class="system-session">
  <video
    class="system-session__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/oceanscale-bg-solution-virtual-ocean.png"
  >
    <source src="/videos/oceanscale-solution-training-motion.mp4" type="video/mp4" />
  </video>
  <div class="system-session__shade"></div>

  <div class="os-container system-session__inner">
    <div class="system-session__head reveal">
      <div>
        <p class="section-label">{copy.label}</p>
        <h2>
          {copy.titleLines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <p>{copy.body}</p>
    </div>

    <div class="system-session__grid">
      <div class="solution-brief reveal" data-delay="1">
        <h3>{copy.briefTitle}</h3>
        <p>{copy.briefBody}</p>
        <div class="solution-brief__rows">
          {copy.rows.map((row) => (
            <article>
              <h4>{row.title}</h4>
              <p>{row.body}</p>
            </article>
        ))}
        </div>
      </div>

      <figure class="system-session__panel reveal" data-delay="2">
        <div class="training-panel" aria-label={copy.panelLabel}>
          <div class="training-panel__top">
            <span>OceanScale Runtime</span>
            <strong>4096 envs</strong>
          </div>
          <div class="training-panel__map">
            {Array.from({ length: 42 }).map((_, index) => (
              <i style={`--delay:${index * 0.045}s; --alpha:${0.16 + ((index * 17) % 42) / 100};`}></i>
            ))}
          </div>
          <div class="training-panel__rows">
            {panelRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style is:global>
  .system-session {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: clamp(4.5rem, 6vw, 5.6rem) 0;
    display: flex;
    align-items: center;
    background: #060b12;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 84px;
  }

  .system-session__media,
  .system-session__shade {
    position: absolute;
    inset: 0;
  }

  .system-session__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.78;
  }

  .system-session__shade {
    background:
      linear-gradient(90deg, rgba(3, 7, 12, 0.94) 0%, rgba(3, 7, 12, 0.7) 42%, rgba(3, 7, 12, 0.36) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 22%),
      linear-gradient(180deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 18%);
  }

  .system-session__inner {
    position: relative;
    z-index: 1;
  }

  .system-session__head {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 0.74fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }

  .system-session__head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.7vw, 3.95rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.48);
  }

  html[lang="zh"] .system-session__head h2 {
    font-family: var(--font-display-zh);
    line-height: 1.08;
  }

  .system-session__head h2 span {
    display: block;
  }

  .system-session__head > p {
    margin: 0 0 0.35rem;
    max-width: 560px;
    color: rgba(232, 237, 243, 0.78);
    font-size: 1.05rem;
    line-height: 1.66;
  }

  .system-session__grid {
    display: grid;
    grid-template-columns: minmax(360px, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.1rem, 3vw, 2.25rem);
    align-items: start;
    margin-top: clamp(1.45rem, 3vw, 2.25rem);
  }

  .solution-brief {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(1.05rem, 1.8vw, 1.4rem);
    background: rgba(3, 7, 12, 0.72);
    backdrop-filter: blur(14px);
  }

  .solution-brief h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.25rem, 2.1vw, 1.72rem);
    font-weight: 850;
    line-height: 1.12;
  }

  .solution-brief > p {
    margin: 0.72rem 0 0;
    color: rgba(232, 237, 243, 0.68);
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .solution-brief__rows {
    display: grid;
    margin-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .solution-brief__rows article {
    padding: 0.82rem 0 0.86rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .solution-brief__rows article:last-child {
    border-bottom: 0;
  }

  .solution-brief__rows h4 {
    margin: 0;
    color: rgba(45, 212, 191, 0.94);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  html[lang="zh"] .solution-brief__rows h4 {
    letter-spacing: 0.12em;
  }

  .solution-brief__rows p {
    margin: 0.38rem 0 0;
    color: rgba(232, 237, 243, 0.7);
    font-size: 0.88rem;
    line-height: 1.52;
  }

  .system-session__panel {
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(6, 11, 18, 0.64);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(14px);
  }

  .training-panel {
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1rem, 2vw, 1.4rem);
    background:
      radial-gradient(circle at 68% 22%, rgba(45, 212, 191, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(5, 10, 16, 0.96), rgba(9, 18, 28, 0.94));
  }

  .training-panel__top,
  .training-panel__rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .training-panel__top {
    min-height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(232, 237, 243, 0.62);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .training-panel__top strong {
    color: rgba(45, 212, 191, 0.96);
  }

  .training-panel__map {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 0.55rem;
    align-content: center;
    min-height: 205px;
    padding: clamp(0.9rem, 1.6vw, 1.35rem) 0;
  }

  .training-panel__map i {
    display: block;
    aspect-ratio: 1;
    border: 1px solid rgba(45, 212, 191, 0.4);
    border-radius: 4px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.22), transparent 18%),
      linear-gradient(135deg, rgba(45, 212, 191, calc(var(--alpha) + 0.22)), rgba(45, 212, 191, 0.04));
    box-shadow:
      inset 0 0 18px rgba(45, 212, 191, 0.2),
      0 0 18px rgba(45, 212, 191, 0.08);
    animation: training-cell 1.4s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  .training-panel__rows {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .training-panel__rows div {
    padding: 0.65rem 0.85rem;
    background: rgba(3, 7, 12, 0.66);
  }

  .training-panel__rows span {
    color: rgba(232, 237, 243, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .training-panel__rows strong {
    color: rgba(232, 237, 243, 0.92);
    font-size: 0.76rem;
  }

  @keyframes training-cell {
    0% { opacity: 0.45; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(-2px); }
  }

  @media (max-width: 980px) {
    .system-session {
      display: block;
      min-height: auto;
      padding: clamp(4.5rem, 12vw, 6rem) 0;
    }

    .system-session__media {
      height: 44vh;
      min-height: 260px;
      object-position: center top;
      mask-image: linear-gradient(180deg, black 0%, transparent 100%);
    }

    .system-session__shade {
      background:
        linear-gradient(180deg, rgba(3, 7, 12, 0.16) 0%, var(--color-bg) 42%, var(--color-bg) 100%),
        linear-gradient(0deg, var(--color-bg) 0%, rgba(6, 11, 18, 0) 34%);
    }

    .system-session__head,
    .system-session__grid {
      grid-template-columns: 1fr;
    }

    .system-session__head {
      gap: 1.05rem;
      padding-top: 33vh;
    }

    .system-session__head h2 {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .system-session__head > p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .training-panel {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .training-panel__rows {
      display: none;
    }

    .training-panel__map {
      min-height: 0;
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

  }
</style>
