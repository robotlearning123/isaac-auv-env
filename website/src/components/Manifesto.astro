---
import zhData from '../content/zh/manifesto';
import enData from '../content/en/manifesto';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const fm: any = lang === 'zh' ? zhData : enData;
const { eyebrow, title, stanzas } = fm;
---
<section class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <img src="/images/manifesto-bg.jpg" alt="" class="w-full h-full object-cover opacity-25" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-abyss-1)]/72 via-[var(--color-abyss-1)]/82 to-[var(--color-abyss-1)]/92"></div>
    {/* Decorative sonar-trace gridlines */}
    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-gradient-to-r from-transparent via-[var(--color-lumen)]/15 to-transparent"></div>
  </div>
  <div class="relative max-w-[1000px] mx-auto px-6 w-full py-24 md:py-32">
    {/* Centered eyebrow + small title */}
    <div class="text-center mb-16 md:mb-24">
      <div class="font-mono text-[var(--color-lumen)] text-xs uppercase eyebrow-tracking mb-4">
        /01 · {eyebrow}
      </div>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-[var(--color-paper)]/85 tracking-tight">
        {title}
      </h2>
    </div>

    {/* Poster stanzas — large, centered, breathable */}
    <div class="space-y-14 md:space-y-20">
      {stanzas.map((line: string, i: number) => (
        <div class="relative">
          {/* Stanza number, tiny, top-right */}
          <div class="font-mono text-[10px] uppercase eyebrow-tracking text-[var(--color-lumen)]/60 mb-3 text-center">
            /0{i + 1}
          </div>
          <p class="font-display text-3xl md:text-5xl lg:text-[3.5rem] leading-[1.25] text-[var(--color-paper)] tracking-tight text-center max-w-[44ch] mx-auto">
            {line}
          </p>
          {i < stanzas.length - 1 && (
            <div class="mt-14 md:mt-20 w-12 h-px bg-[var(--color-lumen)]/30 mx-auto"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
