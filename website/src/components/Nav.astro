---
import { getLangFromUrl, useTranslations, getOtherLangUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherUrl = getOtherLangUrl(lang, Astro.url.pathname);
const isZh = lang === 'zh';
---
<nav class="sticky top-0 z-50 backdrop-blur-2xl bg-[var(--color-abyss-0)]/78 border-b border-[var(--color-border-deep)]">
  <div class="max-w-[1320px] mx-auto px-5 md:px-8 py-4 flex items-center justify-between gap-6">
    <a
      href={isZh ? '/' : '/en/'}
      class="inline-flex items-center gap-3 group min-h-[44px]"
    >
      <img src="/images/logo.png" alt="" class="w-8 h-8 transition-transform duration-300 group-hover:rotate-[30deg]" />
      <span class="font-display text-2xl font-bold tracking-tight text-[var(--color-paper)] group-hover:text-[var(--color-lumen)] transition-colors">
        OceanScale
      </span>
    </a>
    <div class="flex items-center gap-2 sm:gap-4 text-sm">
      <a href="#what" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-paper-dim)] hover:text-[var(--color-acid)] transition-colors">{t('nav.what')}</a>
      <a href="#benchmarks" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-paper-dim)] hover:text-[var(--color-acid)] transition-colors">{t('nav.benchmarks')}</a>
      <a href="#contact" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-paper-dim)] hover:text-[var(--color-acid)] transition-colors">{t('nav.contact')}</a>
      <a
        href={otherUrl}
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] font-mono text-xs border border-[var(--color-border-deep)] px-3 rounded-sm text-[var(--color-paper)] hover:border-[var(--color-acid)] hover:text-[var(--color-acid)] transition-colors"
      >
        {t('lang.other')}
      </a>
    </div>
  </div>
</nav>
