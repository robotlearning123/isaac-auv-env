---
import { getLangFromUrl, useTranslations, getOtherLangUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherUrl = getOtherLangUrl(lang, Astro.url.pathname);
const isZh = lang === 'zh';
---
<nav class="sticky top-0 z-50 backdrop-blur-xl bg-[var(--color-bg)]/90 border-b border-[var(--color-border)]">
  <div class="max-w-[1320px] mx-auto px-5 md:px-8 py-4 flex items-center justify-between gap-6">
    <a
      href={isZh ? '/zh/' : '/'}
      class="inline-flex items-center gap-2.5 min-h-[44px]"
    >
      <span class="font-sans text-xl font-bold tracking-tight text-[var(--color-text)]">
        OceanScale
      </span>
    </a>
    <div class="flex items-center gap-2 sm:gap-4 text-sm">
      <a href="#what" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">{t('nav.what')}</a>
      <a href="#benchmarks" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">{t('nav.benchmarks')}</a>
      <a href="#contact" class="hidden md:inline-flex items-center min-h-[44px] px-2 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">{t('nav.contact')}</a>
      <button
        id="nav-toggle"
        class="md:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] text-[var(--color-text-muted)]"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 nav-icon-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="w-5 h-5 nav-icon-close hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <a
        href={otherUrl}
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] font-mono text-xs border border-[var(--color-border)] px-3 rounded-sm text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        {t('lang.other')}
      </a>
    </div>
  </div>
  <div id="nav-menu" class="md:hidden hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-xl">
    <div class="max-w-[1320px] mx-auto px-5 py-3 flex flex-col gap-1">
      <a href="#what" class="nav-mobile-link">{t('nav.what')}</a>
      <a href="#benchmarks" class="nav-mobile-link">{t('nav.benchmarks')}</a>
      <a href="#contact" class="nav-mobile-link">{t('nav.contact')}</a>
    </div>
  </div>
</nav>
<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const iconOpen = toggle.querySelector('.nav-icon-open');
    const iconClose = toggle.querySelector('.nav-icon-close');
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!open));
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }
</script>
