---
import { getLangFromUrl, useTranslations, getOtherLangUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherUrl = getOtherLangUrl(lang, Astro.url.pathname);
const isZh = lang === 'zh';

const links = [
  { href: '#vision', label: t('nav.vision') },
  { href: '#product', label: t('nav.product') },
  { href: '#benchmarks', label: t('nav.benchmarks') },
  { href: '#roadmap', label: t('nav.roadmap') },
  { href: '#contact', label: t('nav.contact') },
];
---
<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[var(--color-bg)]/20 backdrop-blur-md">
  <div class="max-w-[1480px] mx-auto px-5 md:px-8 py-5 flex items-center justify-between gap-6">
    <a
      href={isZh ? '/zh/' : '/'}
      class="inline-flex items-center gap-2.5 min-h-[44px]"
    >
      <span class="font-sans text-xl font-black tracking-tight text-white">
        OceanScale
      </span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2 text-sm">
      {links.map((link) => (
        <a href={link.href} class="nav-desk-link hidden lg:inline-flex items-center min-h-[44px] px-3 text-white/82 hover:text-white transition-colors text-[12px] font-semibold">{link.label}</a>
      ))}
      <button
        id="nav-toggle"
        class="lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] text-white/82"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 nav-icon-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="w-5 h-5 nav-icon-close hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <a
        href={otherUrl}
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] font-mono text-xs border border-white/18 px-3 rounded-sm text-white hover:border-white/55 transition-colors"
      >
        {t('lang.other')}
      </a>
    </div>
  </div>
  <div id="nav-menu" class="lg:hidden hidden border-t border-white/10 bg-[var(--color-bg)]/96 backdrop-blur-xl">
    <div class="max-w-[1320px] mx-auto px-5 py-3 flex flex-col gap-1">
      {links.map((link) => (
        <a href={link.href} class="nav-mobile-link">{link.label}</a>
      ))}
    </div>
  </div>
</nav>
<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const iconOpen = toggle.querySelector('.nav-icon-open');
    const iconClose = toggle.querySelector('.nav-icon-close');
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!open));
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }
</script>
