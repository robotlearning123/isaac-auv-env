---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative">
    <Nav />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var reveals = document.querySelectorAll('.reveal');
        if (reveals.length) {
          reveals.forEach(function(el) {
            el.style.animation = 'none';
            el.style.opacity = '0';
            el.style.transform = 'translateY(24px)';
            el.style.transition = 'opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1)';
            var delay = el.getAttribute('data-delay');
            if (delay) el.style.transitionDelay = (parseInt(delay) * 0.1) + 's';
          });
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08 });
          reveals.forEach(function(el) { observer.observe(el); });
        }

        var backgroundVideos = Array.prototype.slice.call(document.querySelectorAll('video[data-background-video]'));
        if (!backgroundVideos.length) return;

        function videoIsNearViewport(video) {
          var rect = video.getBoundingClientRect();
          var margin = Math.max(window.innerHeight * 0.75, 360);
          return rect.bottom >= -margin && rect.top <= window.innerHeight + margin;
        }

        function playBackgroundVideo(video) {
          video.muted = true;
          video.defaultMuted = true;
          video.playsInline = true;
          video.preload = 'auto';
          var promise = video.play();
          if (promise && typeof promise.catch === 'function') {
            promise.catch(function() {});
          }
        }

        backgroundVideos.forEach(function(video) {
          video.setAttribute('muted', '');
          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');
          video.addEventListener('loadeddata', function() {
            if (videoIsNearViewport(video)) playBackgroundVideo(video);
          }, { once: true });
        });

        if ('IntersectionObserver' in window) {
          var videoObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) playBackgroundVideo(entry.target);
            });
          }, { rootMargin: '360px 0px', threshold: 0.01 });
          backgroundVideos.forEach(function(video) { videoObserver.observe(video); });
        } else {
          backgroundVideos.forEach(playBackgroundVideo);
        }

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) return;
          backgroundVideos.forEach(function(video) {
            if (videoIsNearViewport(video)) playBackgroundVideo(video);
          });
        });
        window.addEventListener('pageshow', function() {
          backgroundVideos.forEach(function(video) {
            if (videoIsNearViewport(video)) playBackgroundVideo(video);
          });
        });
      });
    </script>
  </body>
</html>
